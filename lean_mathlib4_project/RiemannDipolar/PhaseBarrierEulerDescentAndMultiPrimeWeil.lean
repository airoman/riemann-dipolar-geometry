          rw [hm_cast]
          have hk_ge1 : (1 : ℝ) ≤ ((k + 1 : ℕ) : ℝ) := by exact_mod_cast Nat.succ_pos k
          have hq : 4 * ((k + 1 : ℕ) : ℝ) + 4 ≤ (((k + 1 : ℕ) : ℝ) + 2) ^ 2 - 1 := by nlinarith
          nlinarith
        have he12 : (100000 : ℝ) ≤ Real.exp 12 := by
          have h := exp_ge_pow' (x := 12) (by norm_num) (m := 16) (by norm_num)
          push_cast at h; norm_num at h; linarith
        have hexp_ge : (400 : ℝ) * (100000 : ℝ) ^ (k + 1) ≤ Real.exp (Real.pi * ((m : ℝ) ^ 2 - 1)) := by
          have h1 := Real.exp_le_exp.mpr hbase_arg
          rw [Real.exp_add, mul_comm (12 : ℝ) _, Real.exp_nat_mul] at h1
          have hpow : (100000 : ℝ) ^ (k + 1) ≤ (Real.exp 12) ^ (k + 1) :=
            pow_le_pow_left₀ (by norm_num) he12 (k + 1)
          have h400 : (400 : ℝ) ≤ Real.exp 12 := by linarith
          nlinarith [pow_nonneg (by norm_num : (0 : ℝ) ≤ 100000) (k + 1)]
        have hm4 : (m : ℝ) ^ 4 ≤ 64 * (10 : ℝ) ^ (k + 1) := by
          have hk_pow : ∀ j : ℕ, ((j + 3 : ℕ) : ℝ) ^ 4 ≤ 64 * (10 : ℝ) ^ (j + 1) := by
            intro j
            induction j with
            | zero => norm_num
            | succ r ih =>
              have hstep : ((r + 4 : ℕ) : ℝ) ^ 4 ≤ 10 * ((r + 3 : ℕ) : ℝ) ^ 4 := by
                have h1 : ((r + 4 : ℕ) : ℝ) ≤ (4 / 3 : ℝ) * ((r + 3 : ℕ) : ℝ) := by push_cast; linarith
                have h2 := pow_le_pow_left₀ (by positivity) h1 4
                have h3 : ((4 / 3 : ℝ) * ((r + 3 : ℕ) : ℝ)) ^ 4 = (256 / 81 : ℝ) * ((r + 3 : ℕ) : ℝ) ^ 4 := by ring
                rw [h3] at h2; nlinarith [pow_nonneg (by positivity : (0 : ℝ) ≤ ((r + 3 : ℕ) : ℝ)) 4]
              rw [show (r + 1 + 3 : ℕ) = r + 4 by omega, pow_succ (10 : ℝ)]; linarith
          have hcast : (m : ℝ) = ((k + 3 : ℕ) : ℝ) := by dsimp [m]
