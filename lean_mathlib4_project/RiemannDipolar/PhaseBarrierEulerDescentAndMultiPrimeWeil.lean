theorem xiResolvent_herglotz_schur_hopfBloch_corridor_four :
    (∀ σ γ : ℝ, 0 < σ → σ ≤ 1 / 2 → |γ| ≤ 4 →
      0 < (xiResolvent ((γ : ℂ) + Complex.I * (σ : ℂ))).im ∧
      0 < xiLogForce σ γ ∧
