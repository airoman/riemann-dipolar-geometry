/-- THEOREM II.3 (1.75x EXPANDED CRITICAL-LINE POSITIVITY `Ξ(γ) > 0` ON `[-7, 7]`):
    Using Module #17's order-6 cosine inequality `cos x ≥ 1 - x^2/2 + x^4/24 - x^6/720`
    together with the 51-bin adaptive moments, for EVERY `|γ| ≤ 7`, `Ξ(γ) > 0`! -/
theorem riemannXi_critical_pos_corridor_seven {γ : ℝ} (hγ : |γ| ≤ 7) :
    0 < xiCritical γ := by
  have hcos6 : ∀ x : ℝ, 1 - x ^ 2 / 2 + x ^ 4 / 24 - x ^ 6 / 720 ≤ Real.cos x := by
    intro x
    have h := (abs_le.mp ((cos_sin_sub_taylor_abs_le 3).1 x)).1
    dsimp [cosTaylorPoly] at h
    simp only [Finset.sum_range_succ, Finset.range_zero, Finset.sum_empty, Nat.factorial] at h
    have habs6 : |x| ^ 6 = x ^ 6 := by rw [show (6 : ℕ) = 2 * 3 by rfl, pow_mul, sq_abs, ← pow_mul]
    rw [habs6] at h; norm_num at h; linarith
  have hint_cos : IntegrableOn (fun u : ℝ => riemannPhi u * Real.cos (γ * u)) (Ioi 0) :=
    (integrableOn_phi_pow_cosh 0 0).mono'
      ((continuous_riemannPhi.mul (Real.continuous_cos.comp (continuous_const.mul continuous_id))).aestronglyMeasurable)
      (Filter.Eventually.of_forall fun u => by
        simp only [pow_zero, mul_one, zero_mul, Real.cosh_zero, Real.norm_eq_abs, abs_mul,
                   abs_of_pos (riemannPhi_pos u)]
        exact mul_le_of_le_one_right (le_of_lt (riemannPhi_pos u)) (Real.abs_cos_le_one _))
  have hint0 := integrableOn_phi_pow_cosh 0 0
  have hint2 := (integrableOn_phi_pow_cosh 2 0).const_mul (γ ^ 2 / 2)
  have hint4 := (integrableOn_phi_pow_cosh 4 0).const_mul (γ ^ 4 / 24)
  have hint6 := (integrableOn_phi_pow_cosh 6 0).const_mul (γ ^ 6 / 720)
  have hpoly_int : IntegrableOn
      (fun u : ℝ => riemannPhi u * (1 - (γ * u) ^ 2 / 2 + (γ * u) ^ 4 / 24 - (γ * u) ^ 6 / 720)) (Ioi 0) := by
    have hrew : (fun u : ℝ => riemannPhi u * (1 - (γ * u) ^ 2 / 2 + (γ * u) ^ 4 / 24 - (γ * u) ^ 6 / 720)) =
        fun u => ((riemannPhi u * u ^ 0 * Real.cosh (0 * u) -
          (γ ^ 2 / 2) * (riemannPhi u * u ^ 2 * Real.cosh (0 * u))) +
          (γ ^ 4 / 24) * (riemannPhi u * u ^ 4 * Real.cosh (0 * u))) -
          (γ ^ 6 / 720) * (riemannPhi u * u ^ 6 * Real.cosh (0 * u)) := by
      ext u; simp only [pow_zero, zero_mul, Real.cosh_zero, mul_one]; ring
    rw [hrew]; exact ((hint0.sub hint2).add hint4).sub hint6
  have hmono := MeasureTheory.setIntegral_mono_on hpoly_int hint_cos measurableSet_Ioi fun u _ =>
    mul_le_mul_of_nonneg_left (hcos6 (γ * u)) (le_of_lt (riemannPhi_pos u))
  have hsplit : ∫ u in Ioi (0 : ℝ), riemannPhi u * (1 - (γ * u) ^ 2 / 2 + (γ * u) ^ 4 / 24 - (γ * u) ^ 6 / 720) =
      xiCoshMoment 0 0 - (γ ^ 2 / 2) * xiCoshMoment 2 0 +
      (γ ^ 4 / 24) * xiCoshMoment 4 0 - (γ ^ 6 / 720) * xiCoshMoment 6 0 := by
    have hrew : (fun u : ℝ => riemannPhi u * (1 - (γ * u) ^ 2 / 2 + (γ * u) ^ 4 / 24 - (γ * u) ^ 6 / 720)) =
        fun u => ((riemannPhi u * u ^ 0 * Real.cosh (0 * u) -
          (γ ^ 2 / 2) * (riemannPhi u * u ^ 2 * Real.cosh (0 * u))) +
          (γ ^ 4 / 24) * (riemannPhi u * u ^ 4 * Real.cosh (0 * u))) -
          (γ ^ 6 / 720) * (riemannPhi u * u ^ 6 * Real.cosh (0 * u)) := by
      ext u; simp only [pow_zero, zero_mul, Real.cosh_zero, mul_one]; ring
    rw [hrew]
    have hs1 := MeasureTheory.integral_sub ((hint0.sub hint2).add hint4) hint6
    have hs2 := MeasureTheory.integral_add (hint0.sub hint2) hint4
    have hs3 := MeasureTheory.integral_sub hint0 hint2
    dsimp [Pi.sub_apply, Pi.add_apply] at hs1 hs2 hs3
    rw [hs1, hs2, hs3, MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul,
        MeasureTheory.integral_const_mul]
    rfl
  rw [hsplit] at hmono
  rw [xiCritical_eq_cos_integral]
  simp only [pow_zero, mul_one]
  -- Evaluate the cubic polynomial in `w = γ^2 ∈ [0, 49]` via elementary convexity/endpoints!
  -- Specifically: `P(w) = 238/1000 - (122/20000)*w + (137/2400000)*w^2 - (357/720000000)*w^3`.
  -- Notice `P(w) = (238/1000 - 61/10000 * w + 137/2400000 * w^2) - (357/720000000) * w^3`!
  -- Wait: on `w ∈ [0, 49]`, check if `P'(w) < 0` on ALL of `[0, 49]`, so `P(w) ≥ P(49) > 0`!
  -- `P'(w) = -61/10000 + (137/1200000)*w - (1071/720000000)*w^2`:
  -- At `w = 49`: `-0.0061 + 0.005594 - 0.00357 = -0.00408 < 0`!
  -- Even simpler: `P'(w) = -0.0061 + (137/1200000)*w - ... ≤ -0.0061 + 0.0056 = -0.0005 < 0` for ALL `0 ≤ w ≤ 49`!
  have hw0 : 0 ≤ γ ^ 2 := sq_nonneg γ
  have hw49 : γ ^ 2 ≤ 49 := by
    have h := pow_le_pow_left₀ (abs_nonneg γ) hγ 2
    rw [sq_abs] at h; norm_num at h; exact h
  have hI00 := xiCoshMoment_0_0_ge_238
  have hI20 := xiCoshMoment_2_0_le_122
  have hI40 := xiCoshMoment_4_0_ge_137
  have hI60 := xiCoshMoment_6_0_le_357
  have hpoly_ge : (238 / 1000 : ℝ) - (γ ^ 2 / 2) * (122 / 10000) +
      (γ ^ 4 / 24) * (137 / 100000) - (γ ^ 6 / 720) * (357 / 1000000) ≤
      xiCoshMoment 0 0 - (γ ^ 2 / 2) * xiCoshMoment 2 0 +
      (γ ^ 4 / 24) * xiCoshMoment 4 0 - (γ ^ 6 / 720) * xiCoshMoment 6 0 := by
    have h2 : (γ ^ 2 / 2) * xiCoshMoment 2 0 ≤ (γ ^ 2 / 2) * (122 / 10000) :=
      mul_le_mul_of_nonneg_left hI20 (by positivity)
    have h4 : (γ ^ 4 / 24) * (137 / 100000) ≤ (γ ^ 4 / 24) * xiCoshMoment 4 0 :=
      mul_le_mul_of_nonneg_left hI40 (by positivity)
    have h6 : (γ ^ 6 / 720) * xiCoshMoment 6 0 ≤ (γ ^ 6 / 720) * (357 / 1000000) :=
      mul_le_mul_of_nonneg_left hI60 (by positivity)
    linarith
  have hP_pos : (0 : ℝ) < (238 / 1000 : ℝ) - (γ ^ 2 / 2) * (122 / 10000) +
      (γ ^ 4 / 24) * (137 / 100000) - (γ ^ 6 / 720) * (357 / 1000000) := by
    set w : ℝ := γ ^ 2
    have hP_mono : AntitoneOn (fun t : ℝ => (238 / 1000 : ℝ) - (t / 2) * (122 / 10000) +
        (t ^ 2 / 24) * (137 / 100000) - (t ^ 3 / 720) * (357 / 1000000)) (Icc 0 49) := by
      have hd : ∀ t : ℝ, HasDerivAt (fun x : ℝ => (238 / 1000 : ℝ) - (x / 2) * (122 / 10000) +
          (x ^ 2 / 24) * (137 / 100000) - (x ^ 3 / 720) * (357 / 1000000))
          (-(61 / 10000 : ℝ) + (137 / 1200000) * t - (357 / 240000000) * t ^ 2) t := by
        intro t
        have h1 := ((hasDerivAt_const t (238 / 1000 : ℝ)).sub (((hasDerivAt_id' t).div_const 2).mul_const (122 / 10000))).add
          ((((hasDerivAt_pow 2 t).div_const 24).mul_const (137 / 100000)))
        have h2 := h1.sub (((hasDerivAt_pow 3 t).div_const 720).mul_const (357 / 1000000))
        refine h2.congr_deriv ?_; ring
      apply antitoneOn_of_deriv_nonpos (convex_Icc 0 49)
        (fun t _ => (hd t).continuousAt.continuousWithinAt)
        (fun t _ => (hd t).differentiableAt.differentiableWithinAt)
      intro t ht
      rw [interior_Icc] at ht
      rw [(hd t).deriv]
      nlinarith [sq_nonneg t, ht.1, ht.2]
    have hge49 := hP_mono ⟨hw0, hw49⟩ ⟨by norm_num, le_refl _⟩ hw49
    have h49_pos : (0 : ℝ) < (238 / 1000 : ℝ) - (49 / 2) * (122 / 10000) +
        (49 ^ 2 / 24) * (137 / 100000) - (49 ^ 3 / 720) * (357 / 1000000) := by norm_num
    have hrew : (238 / 1000 : ℝ) - (γ ^ 2 / 2) * (122 / 10000) +
        (γ ^ 4 / 24) * (137 / 100000) - (γ ^ 6 / 720) * (357 / 1000000) =
        (238 / 1000 : ℝ) - (w / 2) * (122 / 10000) +
        (w ^ 2 / 24) * (137 / 100000) - (w ^ 3 / 720) * (357 / 1000000) := by dsimp [w]; ring
    rw [hrew]; linarith
  linarith

/-- Helper: Transverse force positivity `∂_σ V(σ, γ) > 0` for `σ ∈ (0, 1/2]` and `|γ| ≤ 4`. -/
