/-- THEOREM 0.3B (STIRLING-EXP UNIVERSAL FACTORIAL LOWER BOUND FOR ALL `n : ℕ`):
    For EVERY natural number `n : ℕ` (with ZERO explicit factorial computation!):
      `((100 * (n : ℝ) / 272) ^ n) ≤ (n.factorial : ℝ)`. -/
theorem pow_div_272_le_factorial (n : ℕ) :
    ((100 * (n : ℝ) / 272) ^ n) ≤ (n.factorial : ℝ) := by
  have hsingle : (n : ℝ) ^ n / (n.factorial : ℝ) ≤
      ∑ k ∈ Finset.range (n + 1), (n : ℝ) ^ k / (k.factorial : ℝ) :=
    Finset.single_le_sum (f := fun k : ℕ => (n : ℝ) ^ k / (k.factorial : ℝ))
      (fun k _ => by positivity) (Finset.mem_range.mpr (Nat.lt_succ_self n))
  have hexp_ge : (n : ℝ) ^ n / (n.factorial : ℝ) ≤ Real.exp (n : ℝ) :=
    le_trans hsingle (Real.sum_le_exp_of_nonneg (Nat.cast_nonneg n) (n + 1))
  have hexp_le : Real.exp (n : ℝ) ≤ (272 / 100 : ℝ) ^ n := by
    have hpow : Real.exp (n : ℝ) = (Real.exp 1) ^ n := by
      rw [← Real.exp_nat_mul]; simp
    rw [hpow]
    exact pow_le_pow_left₀ (le_of_lt (Real.exp_pos 1)) exp_one_le_272_div_100 n
  have h1 : (n : ℝ) ^ n / (n.factorial : ℝ) ≤ (272 / 100 : ℝ) ^ n := le_trans hexp_ge hexp_le
  have hfac_pos : (0 : ℝ) < (n.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos n
  have h2 : (n : ℝ) ^ n ≤ (272 / 100 : ℝ) ^ n * (n.factorial : ℝ) :=
    (div_le_iff₀ hfac_pos).mp h1
  have heq : (100 * (n : ℝ) / 272) ^ n = (n : ℝ) ^ n / (272 / 100 : ℝ) ^ n := by
    rw [← div_pow]; congr 1; ring
  rw [heq, div_le_iff₀ (by positivity)]
  linarith

