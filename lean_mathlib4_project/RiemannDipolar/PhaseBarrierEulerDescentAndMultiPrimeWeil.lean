        by_cases hvm0 : ArithmeticFunction.vonMangoldt (n + 150) = 0
        · rw [hvm0, zero_div]; linarith [hgnn 1, hgnn 7, hgnn 11, hgnn 13, hgnn 17, hgnn 19, hgnn 23, hgnn 29]
