private lemma re_div_one_sub_polar' {r θ : ℝ} :
    ((r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I) /
      (1 - (r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))).re =
      (r * Real.cos θ - r ^ 2) / (1 - 2 * r * Real.cos θ + r ^ 2) := by
  set z : ℂ := (r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)
  have hz_re : z.re = r * Real.cos θ := by
    dsimp [z]; rw [Complex.exp_mul_I]
    simp [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, Complex.cos_ofReal_re, Complex.sin_ofReal_im]
  have hz_im : z.im = r * Real.sin θ := by
    dsimp [z]; rw [Complex.exp_mul_I]
    simp [Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, Complex.cos_ofReal_im, Complex.sin_ofReal_re]
  have hns : Complex.normSq (1 - z) = 1 - 2 * r * Real.cos θ + r ^ 2 := by
    rw [Complex.normSq_apply]; simp only [Complex.sub_re, Complex.sub_im, Complex.one_re, Complex.one_im, hz_re, hz_im]
    nlinarith [Real.cos_sq_add_sin_sq θ]
  rw [Complex.div_re, hns]
  simp only [Complex.sub_re, Complex.sub_im, Complex.one_re, Complex.one_im, hz_re, hz_im]
  have hnum : (r * Real.cos θ) * (1 - r * Real.cos θ) + (r * Real.sin θ) * (0 - r * Real.sin θ) =
      r * Real.cos θ - r ^ 2 := by nlinarith [Real.cos_sq_add_sin_sq θ]
  rw [← add_div, hnum]

private lemma prime_pow_indicator_hasSum' {p : ℕ} (hp : p.Prime) {β : ℝ} (hβ : 1 < β) (γ : ℝ) :
    HasSum
      (fun n : ℕ => if ∃ k : ℕ, n = p ^ (k + 1) then
        LSeries.term (fun m => (ArithmeticFunction.vonMangoldt m : ℂ)) (⟨β, -γ⟩ : ℂ) n else 0)
      (((Real.log (p : ℝ) : ℝ) : ℂ) *
        ((((p : ℝ) ^ (-β) : ℝ) : ℂ) * Complex.exp (((γ * Real.log (p : ℝ) : ℝ) : ℂ) * Complex.I) /
          (1 - (((p : ℝ) ^ (-β) : ℝ) : ℂ) * Complex.exp (((γ * Real.log (p : ℝ) : ℝ) : ℂ) * Complex.I)))) := by
  have hp_pos : (0 : ℝ) < (p : ℝ) := by exact_mod_cast hp.pos
  have hp_ge2 : (2 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp.two_le
  set z : ℂ := (((p : ℝ) ^ (-β) : ℝ) : ℂ) * Complex.exp (((γ * Real.log (p : ℝ) : ℝ) : ℂ) * Complex.I)
  have hz_norm : ‖z‖ < 1 := by
    dsimp [z]
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (Real.rpow_pos_of_pos hp_pos _),
        Complex.norm_exp_ofReal_mul_I, mul_one]
    have hlt : (p : ℝ) ^ (-β) < (p : ℝ) ^ (0 : ℝ) := Real.rpow_lt_rpow_of_exponent_lt (by linarith) (by linarith)
    simpa using hlt
  have hgeom : HasSum (fun k : ℕ => z ^ (k + 1)) (z / (1 - z)) := by
    have h0 := (hasSum_geometric_of_norm_lt_one hz_norm).mul_left z
    have heq : (fun k : ℕ => z * z ^ k) = fun k => z ^ (k + 1) := by ext k; rw [pow_succ']
    have hval : z * (1 - z)⁻¹ = z / (1 - z) := by rw [div_eq_mul_inv]
    rwa [heq, hval] at h0
  have hmul := hgeom.mul_left ((Real.log (p : ℝ) : ℝ) : ℂ)
  have hinj : Function.Injective (fun k : ℕ => p ^ (k + 1)) := fun a b hab => by
    have h := Nat.pow_right_injective hp.two_le hab; omega
  have hcomp : ∀ k : ℕ,
      (if ∃ j : ℕ, p ^ (k + 1) = p ^ (j + 1) then
        LSeries.term (fun m => (ArithmeticFunction.vonMangoldt m : ℂ)) (⟨β, -γ⟩ : ℂ) (p ^ (k + 1)) else 0) =
      ((Real.log (p : ℝ) : ℝ) : ℂ) * z ^ (k + 1) := by
    intro k
    have hexk : ∃ j : ℕ, p ^ (k + 1) = p ^ (j + 1) := ⟨k, rfl⟩
    simp only [hexk, ↓reduceIte]
    have hne : p ^ (k + 1) ≠ 0 := pow_ne_zero (k + 1) hp.ne_zero
    simp only [LSeries.term, hne, ↓reduceIte]
    have hvm : ArithmeticFunction.vonMangoldt (p ^ (k + 1)) = Real.log (p : ℝ) := by
      rw [ArithmeticFunction.vonMangoldt_apply_pow (Nat.succ_ne_zero k),
          ArithmeticFunction.vonMangoldt_apply_prime hp]
    rw [hvm, div_eq_mul_inv]; congr 1
    rw [← Complex.cpow_neg, Nat.cast_pow,
        Complex.cpow_def_of_ne_zero (pow_ne_zero (k + 1) (by exact_mod_cast hp.ne_zero))]
    have hlog : Complex.log (((p : ℂ)) ^ (k + 1)) = (((k + 1 : ℕ) : ℂ)) * ((Real.log (p : ℝ) : ℝ) : ℂ) := by
      rw [← Complex.ofReal_natCast, ← Complex.ofReal_pow, ← Complex.ofReal_log (by positivity),
          Real.log_pow]; push_cast; ring
    rw [hlog]
    have hz_exp : z = Complex.exp (((-β * Real.log (p : ℝ) : ℝ) : ℂ) +
        ((γ * Real.log (p : ℝ) : ℝ) : ℂ) * Complex.I) := by
      dsimp [z]
      rw [Complex.exp_add, ← Complex.ofReal_exp, Real.rpow_def_of_pos hp_pos]
      congr 3; ring
    rw [hz_exp, ← Complex.exp_nat_mul]
    congr 1; exact Complex.ext (by simp; ring) (by simp; ring)
  have hmul' : HasSum (fun k : ℕ =>
      if ∃ j : ℕ, p ^ (k + 1) = p ^ (j + 1) then
        LSeries.term (fun m => (ArithmeticFunction.vonMangoldt m : ℂ)) (⟨β, -γ⟩ : ℂ) (p ^ (k + 1)) else 0)
      (((Real.log (p : ℝ) : ℝ) : ℂ) * (z / (1 - z))) := by
    have heq : (fun k : ℕ =>
        if ∃ j : ℕ, p ^ (k + 1) = p ^ (j + 1) then
          LSeries.term (fun m => (ArithmeticFunction.vonMangoldt m : ℂ)) (⟨β, -γ⟩ : ℂ) (p ^ (k + 1)) else 0) =
        fun k : ℕ => ((Real.log (p : ℝ) : ℝ) : ℂ) * z ^ (k + 1) := funext hcomp
    rwa [heq]
  exact (hinj.hasSum_iff fun n hn => by
    simp only [Set.mem_range] at hn
    exact ite_eq_right_iff.mpr fun ⟨k, hk⟩ => False.elim (hn ⟨k, hk.symm⟩)).mp hmul'

private lemma prime_pow_disjoint' {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hne : p ≠ q)
    {n : ℕ} (h1 : ∃ k : ℕ, n = p ^ (k + 1)) (h2 : ∃ j : ℕ, n = q ^ (j + 1)) : False := by
  rcases h1 with ⟨k, rfl⟩; rcases h2 with ⟨j, heq⟩
  have hdvd : p ∣ q ^ (j + 1) := by rw [← heq]; exact dvd_pow_self p (Nat.succ_ne_zero k)
  exact hne ((hq.eq_one_or_self_of_dvd p (hp.dvd_of_dvd_pow hdvd)).resolve_left hp.ne_one)

/-- General finite-prime-set Clifford-torus splitting of `Re L(Λ, ⟨β, -γ⟩)` via `Finset.induction_on`! -/
private lemma hasSum_primeFinset_re (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime) {β : ℝ} (hβ : 1 < β) (γ : ℝ) :
    HasSum (fun n : ℕ => if (∃ p ∈ P, ∃ k : ℕ, n = p ^ (k + 1)) then
        (LSeries.term (fun m => (ArithmeticFunction.vonMangoldt m : ℂ)) (⟨β, -γ⟩ : ℂ) n).re else 0)
      (∑ p ∈ P, primePhaseFactor p β γ) := by
  induction P using Finset.induction_on with
  | empty =>
    simp only [Finset.notMem_empty, false_and, exists_false, ↓reduceIte, Finset.sum_empty]
    exact hasSum_zero
  | insert q S hqS ih =>
    have hq_prime : q.Prime := hP q (Finset.mem_insert_self q S)
    have hS_prime : ∀ p ∈ S, p.Prime := fun p hp => hP p (Finset.mem_insert_of_mem hp)
    have hq_sum : HasSum (fun n : ℕ => if (∃ k : ℕ, n = q ^ (k + 1)) then
        (LSeries.term (fun m => (ArithmeticFunction.vonMangoldt m : ℂ)) (⟨β, -γ⟩ : ℂ) n).re else 0)
        (primePhaseFactor q β γ) := by
      have h0 := (prime_pow_indicator_hasSum' hq_prime hβ γ).map Complex.reCLM Complex.reCLM.continuous
      have hfn : (fun n : ℕ => (if ∃ k : ℕ, n = q ^ (k + 1) then
          LSeries.term (fun m => (ArithmeticFunction.vonMangoldt m : ℂ)) (⟨β, -γ⟩ : ℂ) n else 0).re) =
          fun n => if ∃ k : ℕ, n = q ^ (k + 1) then
            (LSeries.term (fun m => (ArithmeticFunction.vonMangoldt m : ℂ)) (⟨β, -γ⟩ : ℂ) n).re else 0 := by
        ext n; split_ifs <;> simp
      have hval : (((Real.log (q : ℝ) : ℝ) : ℂ) *
          ((((q : ℝ) ^ (-β) : ℝ) : ℂ) * Complex.exp (((γ * Real.log (q : ℝ) : ℝ) : ℂ) * Complex.I) /
            (1 - (((q : ℝ) ^ (-β) : ℝ) : ℂ) * Complex.exp (((γ * Real.log (q : ℝ) : ℝ) : ℂ) * Complex.I)))).re =
          primePhaseFactor q β γ := by
        rw [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero, re_div_one_sub_polar']
        rfl
      have h0' : HasSum (fun n : ℕ => (if ∃ k : ℕ, n = q ^ (k + 1) then
          LSeries.term (fun m => (ArithmeticFunction.vonMangoldt m : ℂ)) (⟨β, -γ⟩ : ℂ) n else 0).re)
          (((Real.log (q : ℝ) : ℝ) : ℂ) *
            ((((q : ℝ) ^ (-β) : ℝ) : ℂ) * Complex.exp (((γ * Real.log (q : ℝ) : ℝ) : ℂ) * Complex.I) /
              (1 - (((q : ℝ) ^ (-β) : ℝ) : ℂ) * Complex.exp (((γ * Real.log (q : ℝ) : ℝ) : ℂ) * Complex.I)))).re := h0
      rwa [hfn, hval] at h0'
    have hcomb := hq_sum.add (ih hS_prime)
    rw [Finset.sum_insert hqS]
    refine hcomb.congr_fun fun n => ?_
    by_cases hq_n : ∃ k : ℕ, n = q ^ (k + 1)
    · have hnotS : ¬ ∃ p ∈ S, ∃ k : ℕ, n = p ^ (k + 1) := by
        rintro ⟨p, hpS, hpn⟩
        exact prime_pow_disjoint' hq_prime (hS_prime p hpS) (fun heq => hqS (heq ▸ hpS)) hq_n hpn
      have hins : ∃ p ∈ insert q S, ∃ k : ℕ, n = p ^ (k + 1) := ⟨q, Finset.mem_insert_self q S, hq_n⟩
      simp only [hq_n, hnotS, hins, ↓reduceIte, add_zero]
    · by_cases hS_n : ∃ p ∈ S, ∃ k : ℕ, n = p ^ (k + 1)
      · rcases hS_n with ⟨p, hpS, hpn⟩
        have hins : ∃ p ∈ insert q S, ∃ k : ℕ, n = p ^ (k + 1) := ⟨p, Finset.mem_insert_of_mem hpS, hpn⟩
        have hS_n' : ∃ p ∈ S, ∃ k : ℕ, n = p ^ (k + 1) := ⟨p, hpS, hpn⟩
        simp only [hq_n, hS_n', hins, ↓reduceIte, zero_add]
      · have hnotins : ¬ ∃ p ∈ insert q S, ∃ k : ℕ, n = p ^ (k + 1) := by
          rintro ⟨p, hp, hpn⟩
          rcases Finset.mem_insert.mp hp with rfl | hpS
          · exact hq_n hpn
          · exact hS_n ⟨p, hpS, hpn⟩
        simp only [hq_n, hS_n, hnotins, ↓reduceIte, add_zero]

/-- Exact rational-power telescoping for `∑' k, log (30k + 150 + r) / (30k + 150 + r)^2`!
    Uses `Φ(x) = (Real.log x + 1) / x` with `Φ'(x) = -Real.log x / x^2` (ZERO `rpow`!). -/
private lemma mod30_residue_tail_le (r : ℕ) (hr : 1 ≤ r) (hr29 : r ≤ 29) :
    Summable (fun k : ℕ => Real.log ((30 * k + 150 + r : ℕ) : ℝ) / ((30 * k + 150 + r : ℕ) : ℝ) ^ 2) ∧
    (∑' k : ℕ, Real.log ((30 * k + 150 + r : ℕ) : ℝ) / ((30 * k + 150 + r : ℕ) : ℝ) ^ 2) ≤
      (5011 / 1000 + 1 : ℝ) / (30 * ((120 + r : ℕ) : ℝ)) := by
  let Φ : ℝ → ℝ := fun x => (Real.log x + 1) / x
  have hΦ_deriv : ∀ x : ℝ, 0 < x → HasDerivAt Φ (-Real.log x / x ^ 2) x := by
    intro x hx
    have hnum := (Real.hasDerivAt_log (ne_of_gt hx)).fun_add (hasDerivAt_const x (1 : ℝ))
    have hq := hnum.fun_div (hasDerivAt_id' x) (ne_of_gt hx)
    refine hq.congr_deriv ?_; field_simp [ne_of_gt hx]; ring
  have hdec : ∀ x y : ℝ, 3 ≤ x → x ≤ y → Real.log y / y ^ 2 ≤ Real.log x / x ^ 2 := by
    intro x y hx hxy
    have hd : ∀ t ∈ Icc x y, HasDerivAt (fun u : ℝ => Real.log u / u ^ 2) ((1 - 2 * Real.log t) / t ^ 3) t := by
      intro t ht
      have ht_pos : 0 < t := by linarith [ht.1]
      have hq := (Real.hasDerivAt_log (ne_of_gt ht_pos)).fun_div (hasDerivAt_pow 2 t) (pow_ne_zero 2 (ne_of_gt ht_pos))
      refine hq.congr_deriv ?_; field_simp [ne_of_gt ht_pos]; ring
    have hanti : AntitoneOn (fun u : ℝ => Real.log u / u ^ 2) (Icc x y) := by
      apply antitoneOn_of_deriv_nonpos (convex_Icc x y)
        (fun t ht => (hd t ht).continuousAt.continuousWithinAt)
        (fun t ht => (hd t (interior_subset ht)).differentiableAt.differentiableWithinAt)
      intro t ht
      rw [interior_Icc] at ht
      have ht3 : 3 ≤ t := le_of_lt (lt_of_le_of_lt hx ht.1)
      rw [(hd t ⟨le_of_lt ht.1, le_of_lt ht.2⟩).deriv]
      have hlog_ge : (1 : ℝ) ≤ Real.log t := by
        have h1 : Real.log 3 ≤ Real.log t := Real.log_le_log (by norm_num) ht3
        linarith [log_3_bounds.1]
      exact div_nonpos_of_nonpos_of_nonneg (by linarith) (by positivity)
    exact hanti ⟨le_refl x, hxy⟩ ⟨hxy, le_refl y⟩ hxy
  have hstep : ∀ k : ℕ,
      Real.log ((30 * k + 150 + r : ℕ) : ℝ) / ((30 * k + 150 + r : ℕ) : ℝ) ^ 2 ≤
        (1 / 30 : ℝ) * (Φ ((30 * k + 120 + r : ℕ) : ℝ) - Φ ((30 * (k + 1) + 120 + r : ℕ) : ℝ)) := by
    intro k
    let a : ℝ := ((30 * k + 120 + r : ℕ) : ℝ)
    let b : ℝ := ((30 * k + 150 + r : ℕ) : ℝ)
    have ha3 : 3 ≤ a := by dsimp [a]; exact_mod_cast (by omega : 3 ≤ 30 * k + 120 + r)
    have hab : a ≤ b := by dsimp [a, b]; exact_mod_cast (by omega : 30 * k + 120 + r ≤ 30 * k + 150 + r)
    have hba : b - a = 30 := by dsimp [a, b]; push_cast; ring
    have hb_eq : ((30 * (k + 1) + 120 + r : ℕ) : ℝ) = b := by dsimp [b]; push_cast; ring
    rw [hb_eq]
    have hint_eq : ∫ x in a..b, Real.log x / x ^ 2 = Φ a - Φ b := by
      have hd' : ∀ x ∈ Set.uIcc a b, HasDerivAt (fun u => -Φ u) (Real.log x / x ^ 2) x := by
        intro x hx
        rw [Set.uIcc_of_le hab] at hx
        have h1 := (hΦ_deriv x (by linarith [hx.1])).neg
        refine h1.congr_deriv ?_; ring
      have hc : ContinuousOn (fun x : ℝ => Real.log x / x ^ 2) (Set.uIcc a b) := by
        rw [Set.uIcc_of_le hab]; intro x hx
        have hx0 : x ≠ 0 := ne_of_gt (by linarith [hx.1])
        exact ((Real.continuousAt_log hx0).div (continuousAt_id.pow 2) (pow_ne_zero 2 hx0)).continuousWithinAt
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hd' hc.intervalIntegrable]; ring
    have hconst : 30 * (Real.log b / b ^ 2) = ∫ _x in a..b, Real.log b / b ^ 2 := by
      rw [intervalIntegral.integral_const, smul_eq_mul, hba]
    have hle : ∫ _x in a..b, Real.log b / b ^ 2 ≤ ∫ x in a..b, Real.log x / x ^ 2 := by
      refine intervalIntegral.integral_mono_on hab intervalIntegrable_const ?_ fun x hx => hdec x b (by linarith [hx.1]) hx.2
      apply ContinuousOn.intervalIntegrable
      rw [Set.uIcc_of_le hab]; intro x hx
      have hx0 : x ≠ 0 := ne_of_gt (by linarith [hx.1])
      exact ((Real.continuousAt_log hx0).div (continuousAt_id.pow 2) (pow_ne_zero 2 hx0)).continuousWithinAt
    rw [← hconst, hint_eq] at hle; linarith
  have hpart : ∀ N : ℕ,
      ∑ k ∈ Finset.range N, Real.log ((30 * k + 150 + r : ℕ) : ℝ) / ((30 * k + 150 + r : ℕ) : ℝ) ^ 2 ≤
        (5011 / 1000 + 1 : ℝ) / (30 * ((120 + r : ℕ) : ℝ)) := by
    intro N
    have hsum_le : ∑ k ∈ Finset.range N, Real.log ((30 * k + 150 + r : ℕ) : ℝ) / ((30 * k + 150 + r : ℕ) : ℝ) ^ 2 ≤
        ∑ k ∈ Finset.range N, (1 / 30 : ℝ) * (Φ ((30 * k + 120 + r : ℕ) : ℝ) - Φ ((30 * (k + 1) + 120 + r : ℕ) : ℝ)) :=
      Finset.sum_le_sum fun k _ => hstep k
    rw [← Finset.mul_sum, Finset.sum_range_sub' (fun k : ℕ => Φ ((30 * k + 120 + r : ℕ) : ℝ)) N] at hsum_le
    simp only [mul_zero, zero_add] at hsum_le
