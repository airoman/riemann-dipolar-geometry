  -- Step 2: Prove Part 1 (`β = 2` phase-preserving split)!
  have hpart1 : ∀ γ : ℝ, (LSeries (fun n => (ArithmeticFunction.vonMangoldt n : ℂ)) (⟨2, -γ⟩ : ℂ)).re ≤
