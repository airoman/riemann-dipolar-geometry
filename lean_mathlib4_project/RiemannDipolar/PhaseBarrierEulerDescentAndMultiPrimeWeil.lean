private lemma exp_le_taylor_small {y : ℝ} (hy0 : 0 ≤ y) (hy1 : y ≤ 1) {n : ℕ} (hn : 0 < n) :
    Real.exp y ≤ (∑ k ∈ Finset.range n, y ^ k / (k.factorial : ℝ)) +
      y ^ n * (((n : ℝ) + 1) / ((n.factorial : ℝ) * (n : ℝ))) := by
  have habs : |y| ≤ 1 := by rw [abs_of_nonneg hy0]; exact hy1
  have hb := Real.exp_bound habs hn
  rw [abs_of_nonneg hy0] at hb
  have h1 := (abs_le.mp hb).2
  have hcast : ((n.succ : ℕ) : ℝ) = (n : ℝ) + 1 := by push_cast; rfl
  rw [hcast] at h1
  linarith

private lemma exp_le_pow4_taylor {y B : ℝ} (hy0 : 0 ≤ y) (hy4 : y ≤ 4) (_hB0 : 0 ≤ B)
    (htay : (∑ k ∈ Finset.range 7, (y / 4) ^ k / (k.factorial : ℝ)) +
        (y / 4) ^ 7 * (((7 : ℝ) + 1) / (((7 : ℕ).factorial : ℝ) * 7)) ≤ B) :
    Real.exp y ≤ B ^ 4 := by
  have hq := exp_le_taylor_small (y := y / 4) (by linarith) (by linarith) (n := 7) (by norm_num)
  have hle : Real.exp (y / 4) ≤ B := le_trans hq htay
  have hpow : Real.exp y = (Real.exp (y / 4)) ^ 4 := by
    rw [← Real.exp_nat_mul]; congr 1; ring
  rw [hpow]
  exact pow_le_pow_left₀ (le_of_lt (Real.exp_pos _)) hle 4

private lemma exp_ge_pow4_sum {y A : ℝ} (hy0 : 0 ≤ y) (hA0 : 0 ≤ A)
    (htay : A ≤ ∑ k ∈ Finset.range 8, (y / 4) ^ k / (k.factorial : ℝ)) :
    A ^ 4 ≤ Real.exp y := by
  have h1 := Real.sum_le_exp_of_nonneg (x := y / 4) (by linarith) 8
  have hle : A ≤ Real.exp (y / 4) := le_trans htay h1
  have hpow : Real.exp y = (Real.exp (y / 4)) ^ 4 := by
    rw [← Real.exp_nat_mul]; congr 1; ring
  rw [hpow]
  exact pow_le_pow_left₀ hA0 hle 4

private lemma exp_ge_pow6_sum {y A : ℝ} (hy0 : 0 ≤ y) (hA0 : 0 ≤ A)
    (htay : A ≤ ∑ k ∈ Finset.range 7, (y / 6) ^ k / (k.factorial : ℝ)) :
    A ^ 6 ≤ Real.exp y := by
  have h1 := Real.sum_le_exp_of_nonneg (x := y / 6) (by linarith) 7
  have hle : A ≤ Real.exp (y / 6) := le_trans htay h1
  have hpow : Real.exp y = (Real.exp (y / 6)) ^ 6 := by
    rw [← Real.exp_nat_mul]; congr 1; ring
  rw [hpow]
  exact pow_le_pow_left₀ hA0 hle 6

private lemma log_ge_of_pow4 {lo p : ℝ} (hlo0 : 0 ≤ lo) (hlo4 : lo ≤ 4) (hp : 0 < p)
    (ht : ((∑ k ∈ Finset.range 7, (lo / 4) ^ k / (k.factorial : ℝ)) +
        (lo / 4) ^ 7 * (((7 : ℝ) + 1) / (((7 : ℕ).factorial : ℝ) * 7))) ^ 4 ≤ p) :
    lo ≤ Real.log p := by
  rw [Real.le_log_iff_exp_le hp]
  have h := exp_le_pow4_taylor hlo0 hlo4 (by positivity) le_rfl
  exact le_trans h ht

private lemma log_le_of_pow4 {hi p : ℝ} (hhi0 : 0 ≤ hi) (hp : 0 < p)
    (ht : p ≤ (∑ k ∈ Finset.range 8, (hi / 4) ^ k / (k.factorial : ℝ)) ^ 4) :
    Real.log p ≤ hi := by
  rw [Real.log_le_iff_le_exp hp]
  have hA0 : 0 ≤ ∑ k ∈ Finset.range 8, (hi / 4) ^ k / (k.factorial : ℝ) :=
    Finset.sum_nonneg fun k _ => by positivity
  exact le_trans ht (exp_ge_pow4_sum hhi0 hA0 le_rfl)

private lemma log_le_of_pow6 {hi p : ℝ} (hhi0 : 0 ≤ hi) (hp : 0 < p)
    (ht : p ≤ (∑ k ∈ Finset.range 7, (hi / 6) ^ k / (k.factorial : ℝ)) ^ 6) :
    Real.log p ≤ hi := by
  rw [Real.log_le_iff_le_exp hp]
  have hA0 : 0 ≤ ∑ k ∈ Finset.range 7, (hi / 6) ^ k / (k.factorial : ℝ) :=
    Finset.sum_nonneg fun k _ => by positivity
  exact le_trans ht (exp_ge_pow6_sum hhi0 hA0 le_rfl)

