  have h1 : riemannXi (((1 / 2 + σ : ℝ) : ℂ) + Complex.I * (γ : ℂ)) ≠ 0 :=
    riemannXi_ne_zero_of_one_le_re (by simp; linarith)
  have h2 : riemannXi (((1 / 2 + σ : ℝ) : ℂ) + Complex.I * ((-γ : ℝ) : ℂ)) ≠ 0 :=
    riemannXi_ne_zero_of_one_le_re (by simp; linarith)
  rw [(xiResolvent_im_eq_logForce_half h1).2, (xiResolvent_im_eq_logForce_half h2).2]
  have hev : ∀ s : ℝ, xiNormSq s (-γ) = xiNormSq s γ := fun s => xiNormSq_even_gamma s γ
  have hV_eq : xiNormSq σ (-γ) = xiNormSq σ γ := hev σ
  have hV_pos : 0 < xiNormSq σ γ := by
    dsimp [xiNormSq]
    have harg : (⟨1 / 2 + σ, γ⟩ : ℂ) = ((1 / 2 + σ : ℝ) : ℂ) + Complex.I * (γ : ℂ) := by
      apply Complex.ext <;> simp
    rw [harg]; exact sq_pos_of_pos (norm_pos_iff.mpr h1)
  have hV_pos' : 0 < xiNormSq σ (-γ) := by rwa [hV_eq]
  rw [xiLogForce_eq_force_div_normSq hV_pos, xiLogForce_eq_force_div_normSq hV_pos']
  have hfun : (fun s : ℝ => xiNormSq s (-γ)) = fun s : ℝ => xiNormSq s γ := funext hev
  rw [hfun, hV_eq]

/-- Unconditional Herglotz positivity on the ENTIRE vertical line `σ = 3/2` (`β = 2`) for ALL `γ : ℝ`! -/
private lemma xiResolvent_im_pos_beta2_all (γ : ℝ) :
