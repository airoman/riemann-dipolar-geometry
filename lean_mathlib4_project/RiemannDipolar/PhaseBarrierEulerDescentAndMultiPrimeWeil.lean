/-- General finite real Dirichlet polynomial on the frequency spectrum `{log n}`:
    `D(S, w, t) = ∑_{n ∈ S} w(n) * exp(-i t log n)`. -/
noncomputable def dirichletPoly (S : Finset ℕ) (w : ℕ → ℝ) (t : ℝ) : ℂ :=
  ∑ n ∈ S, ((w n : ℝ) : ℂ) * Complex.exp (-Complex.I * ((t : ℂ) * ((Real.log (n : ℝ) : ℝ) : ℂ)))

private lemma integral_cos_symm_eq' {ω T : ℝ} (hω : ω ≠ 0) :
    ∫ t in (-T)..T, Real.cos (ω * t) = 2 * Real.sin (ω * T) / ω := by
  let F : ℝ → ℝ := fun t => Real.sin (ω * t) / ω
  have hd : ∀ t ∈ Set.uIcc (-T) T, HasDerivAt F (Real.cos (ω * t)) t := by
    intro t _
    have h1 := ((Real.hasDerivAt_sin (ω * t)).comp t ((hasDerivAt_id' t).const_mul ω)).div_const ω
    refine h1.congr_deriv ?_; field_simp [hω]
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hd
    ((Real.continuous_cos.comp (continuous_const.mul continuous_id)).intervalIntegrable _ _)]
  dsimp [F]
  rw [show ω * -T = -(ω * T) by ring, Real.sin_neg]; ring

private lemma continuous_sum_real' {ι : Type*} (s : Finset ι) (f : ι → ℝ → ℝ)
    (hf : ∀ i ∈ s, Continuous (f i)) : Continuous (fun t => ∑ i ∈ s, f i t) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [continuous_const]
  | insert y t hy ih =>
    have hrew : (fun z => ∑ i ∈ insert y t, f i z) = fun z => f y z + ∑ i ∈ t, f i z := by
      ext z; exact Finset.sum_insert hy
    rw [hrew]
    exact (hf y (Finset.mem_insert_self y t)).add
      (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))

private lemma intervalIntegral_sum_real' {ι : Type*} (s : Finset ι) (f : ι → ℝ → ℝ) (a b : ℝ)
    (hf : ∀ i ∈ s, Continuous (f i)) :
    ∫ t in a..b, (∑ i ∈ s, f i t) = ∑ i ∈ s, ∫ t in a..b, f i t := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert x s hx ih =>
    have hcx : Continuous (f x) := hf x (Finset.mem_insert_self x s)
    have hcs : Continuous (fun t => ∑ i ∈ s, f i t) :=
      continuous_sum_real' s f (fun i hi => hf i (Finset.mem_insert_of_mem hi))
    have hrew : (fun t => ∑ i ∈ insert x s, f i t) = fun t => f x t + ∑ i ∈ s, f i t := by
      ext t; exact Finset.sum_insert hx
    rw [hrew, intervalIntegral.integral_add (hcx.intervalIntegrable _ _) (hcs.intervalIntegrable _ _),
        Finset.sum_insert hx, ih (fun i hi => hf i (Finset.mem_insert_of_mem hi))]

/-- THEOREM I.5 (EXACT GENERAL BOHR-PARSEVAL MEAN-SQUARE ERGODIC LIMIT FOR ARBITRARY REAL
    DIRICHLET POLYNOMIALS):
    For EVERY finite set `S : Finset ℕ` of positive integers (`∀ n ∈ S, 1 ≤ n`) and EVERY
    real coefficient function `w : ℕ → ℝ`:
      `Tendsto (fun T => (1 / (2 * T)) * ∫ t in (-T)..T, ‖dirichletPoly S w t‖^2)
        atTop (𝓝 (∑ n ∈ S, (w n)^2))`! -/
theorem bohr_dirichlet_polynomial_mean_square_limit (S : Finset ℕ) (hS : ∀ n ∈ S, 1 ≤ n)
    (w : ℕ → ℝ) :
    Tendsto (fun T : ℝ => (1 / (2 * T)) * ∫ t in (-T)..T, ‖dirichletPoly S w t‖ ^ 2)
      atTop (𝓝 (∑ n ∈ S, (w n) ^ 2)) := by
  classical
  have hnorm_sq : ∀ t : ℝ, ‖dirichletPoly S w t‖ ^ 2 =
      ∑ m ∈ S, ∑ n ∈ S, w m * w n * Real.cos (Real.log ((m : ℝ) / (n : ℝ)) * t) := by
    intro t
    have hmul : (‖dirichletPoly S w t‖ ^ 2 : ℝ) =
        (dirichletPoly S w t * starRingEnd ℂ (dirichletPoly S w t)).re := by
      rw [Complex.mul_conj, Complex.ofReal_re, Complex.sq_norm]
    rw [hmul]; dsimp [dirichletPoly]
    rw [map_sum, Finset.sum_mul]; simp_rw [Finset.mul_sum]; rw [Complex.re_sum]
    refine Finset.sum_congr rfl fun m hm => ?_
    rw [Complex.re_sum]
    refine Finset.sum_congr rfl fun n hn => ?_
    have hm_pos : (0 : ℝ) < (m : ℝ) := by exact_mod_cast (by have := hS m hm; omega : 0 < m)
    have hn_pos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast (by have := hS n hn; omega : 0 < n)
    rw [map_mul, Complex.conj_ofReal, ← Complex.exp_conj]
    have hconj : (starRingEnd ℂ) (-Complex.I * ((t : ℂ) * ((Real.log (n : ℝ) : ℝ) : ℂ))) =
        Complex.I * ((t : ℂ) * ((Real.log (n : ℝ) : ℝ) : ℂ)) := by
      rw [map_mul, map_mul, map_neg, Complex.conj_I, Complex.conj_ofReal, Complex.conj_ofReal]; ring
    rw [hconj]
    have hexp : Complex.exp (-Complex.I * ((t : ℂ) * ((Real.log (m : ℝ) : ℝ) : ℂ))) *
        Complex.exp (Complex.I * ((t : ℂ) * ((Real.log (n : ℝ) : ℝ) : ℂ))) =
        Complex.exp (((-(Real.log ((m : ℝ) / (n : ℝ)) * t) : ℝ) : ℂ) * Complex.I) := by
      rw [← Complex.exp_add, Real.log_div (ne_of_gt hm_pos) (ne_of_gt hn_pos)]
      congr 1; push_cast; ring
    have hprod : ((w m : ℂ) * Complex.exp (-Complex.I * ((t : ℂ) * ((Real.log (m : ℝ) : ℝ) : ℂ)))) *
        ((w n : ℂ) * Complex.exp (Complex.I * ((t : ℂ) * ((Real.log (n : ℝ) : ℝ) : ℂ)))) =
        ((w m * w n : ℝ) : ℂ) * Complex.exp (((-(Real.log ((m : ℝ) / (n : ℝ)) * t) : ℝ) : ℂ) * Complex.I) := by
      calc _ = ((w m : ℂ) * (w n : ℂ)) * (Complex.exp (-Complex.I * ((t : ℂ) * ((Real.log (m : ℝ) : ℝ) : ℂ))) *
            Complex.exp (Complex.I * ((t : ℂ) * ((Real.log (n : ℝ) : ℝ) : ℂ)))) := by ring
        _ = _ := by rw [hexp]; push_cast; ring
    rw [hprod, Complex.exp_mul_I]
    simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, Complex.add_re,
               Complex.cos_ofReal_re, Complex.sin_ofReal_re, Complex.I_re, Complex.I_im,
               Complex.sin_ofReal_im, mul_zero, zero_mul, sub_zero, add_zero]
    rw [Real.cos_neg]
  have hid : ∀ T : ℝ, 0 < T →
      (1 / (2 * T)) * (∫ t in (-T)..T, ‖dirichletPoly S w t‖ ^ 2) =
        (∑ n ∈ S, (w n) ^ 2) +
        (1 / T) * ∑ m ∈ S, ∑ n ∈ S.erase m,
          w m * w n * (Real.sin (T * Real.log ((m : ℝ) / (n : ℝ))) / Real.log ((m : ℝ) / (n : ℝ))) := by
    intro T hT
    simp_rw [hnorm_sq]
    rw [intervalIntegral_sum_real' S (fun m t => ∑ n ∈ S, w m * w n * Real.cos (Real.log ((m : ℝ) / (n : ℝ)) * t))
        (-T) T (fun m _ => continuous_sum_real' S (fun n t => w m * w n * Real.cos (Real.log ((m : ℝ) / (n : ℝ)) * t))
          (fun n _ => continuous_const.mul (Real.continuous_cos.comp (continuous_const.mul continuous_id))))]
    have hinner : ∀ m ∈ S,
        ∫ t in (-T)..T, (∑ n ∈ S, w m * w n * Real.cos (Real.log ((m : ℝ) / (n : ℝ)) * t)) =
          (2 * T) * (w m) ^ 2 +
            2 * ∑ n ∈ S.erase m,
              w m * w n * (Real.sin (T * Real.log ((m : ℝ) / (n : ℝ))) / Real.log ((m : ℝ) / (n : ℝ))) := by
      intro m hm
      rw [intervalIntegral_sum_real' S (fun n t => w m * w n * Real.cos (Real.log ((m : ℝ) / (n : ℝ)) * t))
          (-T) T (fun n _ => continuous_const.mul (Real.continuous_cos.comp (continuous_const.mul continuous_id))),
          ← Finset.add_sum_erase S _ hm]
      have hm_pos : (0 : ℝ) < (m : ℝ) := by exact_mod_cast (by have := hS m hm; omega : 0 < m)
      have hdiag : ∫ t in (-T)..T, w m * w m * Real.cos (Real.log ((m : ℝ) / (m : ℝ)) * t) =
          (2 * T) * (w m) ^ 2 := by
        rw [div_self (ne_of_gt hm_pos), Real.log_one]
        simp only [zero_mul, Real.cos_zero, mul_one, intervalIntegral.integral_const, smul_eq_mul]; ring
      have hoff : ∑ n ∈ S.erase m, ∫ t in (-T)..T, w m * w n * Real.cos (Real.log ((m : ℝ) / (n : ℝ)) * t) =
          2 * ∑ n ∈ S.erase m,
            w m * w n * (Real.sin (T * Real.log ((m : ℝ) / (n : ℝ))) / Real.log ((m : ℝ) / (n : ℝ))) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun n hn => ?_
        have hne : n ≠ m := Finset.ne_of_mem_erase hn
        have hn_pos : (0 : ℝ) < (n : ℝ) := by
          exact_mod_cast (by have := hS n (Finset.mem_of_mem_erase hn); omega : 0 < n)
        have hω_ne : Real.log ((m : ℝ) / (n : ℝ)) ≠ 0 := by
          intro h0
          have hdiv1 : (m : ℝ) / (n : ℝ) = 1 := by
            have := congrArg Real.exp h0
            rw [Real.exp_log (div_pos hm_pos hn_pos), Real.exp_zero] at this; exact this
          have heq : (m : ℝ) = (n : ℝ) := by rwa [div_eq_one_iff_eq (ne_of_gt hn_pos)] at hdiv1
          exact hne ((Nat.cast_injective heq).symm)
        rw [intervalIntegral.integral_const_mul, integral_cos_symm_eq' hω_ne]
        rw [mul_comm (Real.log ((m : ℝ) / (n : ℝ))) T]; ring
      rw [hdiag, hoff]
    rw [Finset.sum_congr rfl hinner, Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    field_simp [ne_of_gt hT]
  let C_off : ℝ := ∑ m ∈ S, ∑ n ∈ S.erase m,
    |w m| * |w n| * (1 / |Real.log ((m : ℝ) / (n : ℝ))|)
  have hbound : ∀ᶠ T : ℝ in atTop,
      |(1 / (2 * T)) * (∫ t in (-T)..T, ‖dirichletPoly S w t‖ ^ 2) - ∑ n ∈ S, (w n) ^ 2| ≤ C_off / T := by
    filter_upwards [Filter.eventually_gt_atTop (0 : ℝ)] with T hT
    rw [hid T hT, add_sub_cancel_left, abs_mul, abs_of_pos (one_div_pos.mpr hT), one_div_mul_eq_div]
    refine div_le_div_of_nonneg_right ?_ (le_of_lt hT)
    dsimp [C_off]
    refine le_trans (Finset.abs_sum_le_sum_abs _ _) (Finset.sum_le_sum fun m _ => ?_)
    refine le_trans (Finset.abs_sum_le_sum_abs _ _) (Finset.sum_le_sum fun n _ => ?_)
    rw [abs_mul, abs_mul, abs_div]
    exact mul_le_mul_of_nonneg_left
      (div_le_div_of_nonneg_right (Real.abs_sin_le_one _) (abs_nonneg _))
      (mul_nonneg (abs_nonneg _) (abs_nonneg _))
  have hlim0 : Tendsto (fun T : ℝ => C_off / T) atTop (𝓝 0) := by
    simpa using tendsto_const_nhds.div_atTop (a := C_off) tendsto_id
  rw [Metric.tendsto_atTop] at hlim0 ⊢
  intro ε hε
  rcases hlim0 ε hε with ⟨M1, hM1⟩
  rcases Filter.eventually_atTop.mp hbound with ⟨M2, hM2⟩
  refine ⟨max M1 (max M2 1), fun T hT => ?_⟩
  rw [Real.dist_eq]
  have hT1 : M1 ≤ T := le_trans (le_max_left _ _) hT
  have hT2 : M2 ≤ T := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hT
  have hTpos : 0 < T := lt_of_lt_of_le (by norm_num) (le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hT)
  have hC_nn : 0 ≤ C_off := Finset.sum_nonneg fun m _ => Finset.sum_nonneg fun n _ => by positivity
  have h1 := hM1 T hT1
  rw [Real.dist_eq, sub_zero, abs_of_nonneg (div_nonneg hC_nn (le_of_lt hTpos))] at h1
  exact lt_of_le_of_lt (hM2 T hT2) h1

-- ==============================================================================
-- PART II: ROUTE B — TOPOLOGICAL CONFINEMENT BARRIER STIFFNESS (B'' ≥ 256) AND
--          2x EXPANDED CONSTRUCTIVE CRITICAL-STRIP CORRIDOR (0, 1) × [-4, 4]
--          & Ξ(γ) > 0 ON [-7, 7] DIRECTLY ON MATHLIB4's `riemannZeta`!
-- ==============================================================================

/-- Topological confinement barrier potential on the open critical strip `(0, 1)`:
    `B(β) = 1 / (β^2 * (1 - β)^2)`. -/
noncomputable def topologicalBarrier (β : ℝ) : ℝ :=
  1 / (β ^ 2 * (1 - β) ^ 2)

/-- Compact angular Hopf coordinate mapping `(0, π)` bijectively onto `(0, 1)`:
    `β(θ) = cos(θ / 2)^2`. -/
noncomputable def hopfAngularCoord (θ : ℝ) : ℝ :=
  (Real.cos (θ / 2)) ^ 2

/-- THEOREM II.1 (EXACT TOPOLOGICAL CONFINEMENT BARRIER RIGIDITY & UNIFORM HESSIAN STIFFNESS GAP):
    For the critical-strip confinement barrier `B(β) = 1 / (β^2 (1 - β)^2)` under the compact
    angular coordinate `β(θ) = cos(θ/2)^2`:
    (1) Exact Hopf-sine identity on `(0, π)`: `0 < β(θ) < 1` and `B(β(θ)) = 16 / sin(θ)^4`;
    (2) Unique global minimum on `(0, 1)` at the critical line `β = 1/2`:
        `16 ≤ B(β)`, `B(1/2) = 16`, equality iff `β = 1/2`, and `B'(1/2) = 0`;
    (3) Uniform strictly positive Hessian stiffness gap on ALL of `(0, 1)`:
        `256 ≤ B''(β)` for EVERY `β ∈ (0, 1)` (attained sharply at `B''(1/2) = 256`);
    (4) Uniform strictly positive angular Hessian stiffness gap on ALL of `(0, π)`:
        `64 ≤ (B ∘ β)''(θ)` for EVERY `θ ∈ (0, π)` (attained sharply at `θ = π/2`). -/
theorem criticalStrip_topologicalBarrier_rigidity :
    (∀ θ ∈ Ioo (0 : ℝ) Real.pi,
      0 < hopfAngularCoord θ ∧ hopfAngularCoord θ < 1 ∧
      topologicalBarrier (hopfAngularCoord θ) = 16 / (Real.sin θ) ^ 4) ∧
    (topologicalBarrier (1 / 2) = 16 ∧
      deriv topologicalBarrier (1 / 2) = 0 ∧
      ∀ β ∈ Ioo (0 : ℝ) 1, 16 ≤ topologicalBarrier β ∧ (topologicalBarrier β = 16 ↔ β = 1 / 2)) ∧
    (∀ β ∈ Ioo (0 : ℝ) 1, 256 ≤ deriv (fun x : ℝ => deriv topologicalBarrier x) β) ∧
    (∀ θ ∈ Ioo (0 : ℝ) Real.pi,
      64 ≤ deriv (fun t : ℝ => deriv (fun u : ℝ => topologicalBarrier (hopfAngularCoord u)) t) θ) := by
  -- Helper: first & second derivatives of `topologicalBarrier` on `(0, 1)`
  have hd1 : ∀ β ∈ Ioo (0 : ℝ) 1,
      HasDerivAt topologicalBarrier (-2 * (1 - 2 * β) / (β * (1 - β)) ^ 3) β := by
    intro β hβ
    have hu_pos : 0 < β * (1 - β) := mul_pos hβ.1 (by linarith [hβ.2])
    have hu_ne : β * (1 - β) ≠ 0 := ne_of_gt hu_pos
    have hdu : HasDerivAt (fun x : ℝ => x * (1 - x)) (1 - 2 * β) β := by
      have h := (hasDerivAt_id' β).fun_mul ((hasDerivAt_const β (1 : ℝ)).fun_sub (hasDerivAt_id' β))
      refine h.congr_deriv ?_; ring
    have hdu2 : HasDerivAt (fun x : ℝ => (x * (1 - x)) ^ 2) (2 * (β * (1 - β)) * (1 - 2 * β)) β := by
      have h := hdu.pow 2
      refine h.congr_deriv ?_; ring
    have hinv := (hasDerivAt_const β (1 : ℝ)).fun_div hdu2 (pow_ne_zero 2 hu_ne)
    have hfun : (fun x : ℝ => (1 : ℝ) / (x * (1 - x)) ^ 2) = topologicalBarrier := by
      ext x; dsimp [topologicalBarrier]; rw [mul_pow]
    rw [hfun] at hinv
    refine hinv.congr_deriv ?_
    field_simp [hu_ne]; ring
  have hd2 : ∀ β ∈ Ioo (0 : ℝ) 1,
      HasDerivAt (fun x : ℝ => deriv topologicalBarrier x)
        ((6 * (1 - 2 * β) ^ 2 + 4 * (β * (1 - β))) / (β * (1 - β)) ^ 4) β := by
    intro β hβ
    have hu_pos : 0 < β * (1 - β) := mul_pos hβ.1 (by linarith [hβ.2])
    have hu_ne : β * (1 - β) ≠ 0 := ne_of_gt hu_pos
    have hev : (fun x : ℝ => deriv topologicalBarrier x) =ᶠ[𝓝 β]
        (fun x : ℝ => -2 * (1 - 2 * x) / (x * (1 - x)) ^ 3) := by
      filter_upwards [isOpen_Ioo.mem_nhds hβ] with x hx
      exact (hd1 x hx).deriv
    refine HasDerivAt.congr_of_eventuallyEq ?_ hev
    have hnum : HasDerivAt (fun x : ℝ => -2 * (1 - 2 * x)) 4 β := by
      have h := ((hasDerivAt_const β (1 : ℝ)).fun_sub ((hasDerivAt_id' β).const_mul 2)).const_mul (-2 : ℝ)
      refine h.congr_deriv ?_; ring
    have hdu : HasDerivAt (fun x : ℝ => x * (1 - x)) (1 - 2 * β) β := by
      have h := (hasDerivAt_id' β).fun_mul ((hasDerivAt_const β (1 : ℝ)).fun_sub (hasDerivAt_id' β))
      refine h.congr_deriv ?_; ring
    have hden : HasDerivAt (fun x : ℝ => (x * (1 - x)) ^ 3) (3 * (β * (1 - β)) ^ 2 * (1 - 2 * β)) β := by
      have h := hdu.pow 3
      refine h.congr_deriv ?_; ring
    have hq := hnum.fun_div hden (pow_ne_zero 3 hu_ne)
    refine hq.congr_deriv ?_
    field_simp [hu_ne]; ring
  -- Part 1: Exact Hopf-sine identity on `(0, π)`
  have hpart1 : ∀ θ ∈ Ioo (0 : ℝ) Real.pi,
      0 < hopfAngularCoord θ ∧ hopfAngularCoord θ < 1 ∧
      topologicalBarrier (hopfAngularCoord θ) = 16 / (Real.sin θ) ^ 4 := by
    intro θ hθ
    have hcos_pos : 0 < Real.cos (θ / 2) :=
      Real.cos_pos_of_mem_Ioo ⟨by linarith [hθ.1, Real.pi_pos], by linarith [hθ.2]⟩
    have hsin_pos : 0 < Real.sin (θ / 2) :=
      Real.sin_pos_of_pos_of_lt_pi (by linarith [hθ.1]) (by linarith [hθ.2, Real.pi_pos])
    have h1_sub : 1 - hopfAngularCoord θ = (Real.sin (θ / 2)) ^ 2 := by
      dsimp [hopfAngularCoord]; linarith [Real.sin_sq_add_cos_sq (θ / 2)]
    have hsin_double : Real.sin θ = 2 * Real.sin (θ / 2) * Real.cos (θ / 2) := by
      have := Real.sin_two_mul (θ / 2)
      rwa [show 2 * (θ / 2) = θ by ring] at this
    refine ⟨sq_pos_of_pos hcos_pos, by linarith [sq_pos_of_pos hsin_pos], ?_⟩
    dsimp [topologicalBarrier]
    rw [h1_sub, hsin_double]
    dsimp [hopfAngularCoord]
    have hs_ne : Real.sin (θ / 2) ≠ 0 := ne_of_gt hsin_pos
    have hc_ne : Real.cos (θ / 2) ≠ 0 := ne_of_gt hcos_pos
    field_simp [hs_ne, hc_ne]; ring
  -- Part 2: Unique global minimum 16 at `β = 1/2`
  have hpart2 : topologicalBarrier (1 / 2) = 16 ∧
      deriv topologicalBarrier (1 / 2) = 0 ∧
      ∀ β ∈ Ioo (0 : ℝ) 1, 16 ≤ topologicalBarrier β ∧ (topologicalBarrier β = 16 ↔ β = 1 / 2) := by
    have hval : topologicalBarrier (1 / 2) = 16 := by dsimp [topologicalBarrier]; norm_num
    have hder : deriv topologicalBarrier (1 / 2) = 0 := by
      have := (hd1 (1 / 2) ⟨by norm_num, by norm_num⟩).deriv
      norm_num at this; exact this
    refine ⟨hval, hder, fun β hβ => ?_⟩
    have hu_pos : 0 < β * (1 - β) := mul_pos hβ.1 (by linarith [hβ.2])
    have hu_le : β * (1 - β) ≤ 1 / 4 := by nlinarith [sq_nonneg (β - 1 / 2)]
    have hb_pos : 0 < β := hβ.1
    have h1b : 0 < 1 - β := by linarith [hβ.2]
    have hden_pos : 0 < β ^ 2 * (1 - β) ^ 2 := by positivity
    have hden_le : β ^ 2 * (1 - β) ^ 2 ≤ 1 / 16 := by
      have hsq := pow_le_pow_left₀ (le_of_lt hu_pos) hu_le 2
      rw [mul_pow] at hsq; norm_num at hsq; exact hsq
    refine ⟨?_, ?_⟩
    · dsimp [topologicalBarrier]; rw [le_div_iff₀ hden_pos]; linarith
    · constructor
      · intro heq
        dsimp [topologicalBarrier] at heq
        have h1 : 1 = 16 * (β ^ 2 * (1 - β) ^ 2) := by
          have := (div_eq_iff (ne_of_gt hden_pos)).mp heq; linarith
        have hu_eq : β * (1 - β) = 1 / 4 := by
          have hsq : (β * (1 - β)) ^ 2 = (1 / 4 : ℝ) ^ 2 := by rw [mul_pow]; linarith
          nlinarith [hu_pos]
        nlinarith [sq_nonneg (β - 1 / 2)]
      · rintro rfl; exact hval
  -- Part 3: Uniform Hessian stiffness gap `B''(β) ≥ 256` on `(0, 1)`
  have hpart3 : ∀ β ∈ Ioo (0 : ℝ) 1, 256 ≤ deriv (fun x : ℝ => deriv topologicalBarrier x) β := by
    intro β hβ
    rw [(hd2 β hβ).deriv]
    have hu_pos : 0 < β * (1 - β) := mul_pos hβ.1 (by linarith [hβ.2])
    have hu_le : β * (1 - β) ≤ 1 / 4 := by nlinarith [sq_nonneg (β - 1 / 2)]
    have hu3_le : (β * (1 - β)) ^ 3 ≤ 1 / 64 := by
      have h := pow_le_pow_left₀ (le_of_lt hu_pos) hu_le 3
      norm_num at h; exact h
    rw [le_div_iff₀ (pow_pos hu_pos 4)]
    have h4 : 256 * (β * (1 - β)) ^ 4 ≤ 4 * (β * (1 - β)) := by
      have : (β * (1 - β)) ^ 4 = (β * (1 - β)) ^ 3 * (β * (1 - β)) := by ring
      rw [this]; nlinarith
    nlinarith [sq_nonneg (1 - 2 * β)]
  -- Part 4: Uniform angular Hessian stiffness gap `(B ∘ β)''(θ) ≥ 64` on `(0, π)`
  have hpart4 : ∀ θ ∈ Ioo (0 : ℝ) Real.pi,
      64 ≤ deriv (fun t : ℝ => deriv (fun u : ℝ => topologicalBarrier (hopfAngularCoord u)) t) θ := by
    have hF1 : ∀ θ ∈ Ioo (0 : ℝ) Real.pi,
        HasDerivAt (fun u : ℝ => topologicalBarrier (hopfAngularCoord u))
          (-64 * Real.cos θ / (Real.sin θ) ^ 5) θ := by
      intro θ hθ
      have hs_pos : 0 < Real.sin θ := Real.sin_pos_of_pos_of_lt_pi hθ.1 hθ.2
      have hs_ne : Real.sin θ ≠ 0 := ne_of_gt hs_pos
      have hev : (fun u : ℝ => topologicalBarrier (hopfAngularCoord u)) =ᶠ[𝓝 θ]
          (fun u : ℝ => 16 / (Real.sin u) ^ 4) := by
        filter_upwards [isOpen_Ioo.mem_nhds hθ] with u hu
        exact (hpart1 u hu).2.2
      refine HasDerivAt.congr_of_eventuallyEq ?_ hev
      have hden : HasDerivAt (fun u : ℝ => (Real.sin u) ^ 4) (4 * (Real.sin θ) ^ 3 * Real.cos θ) θ := by
        have h := (Real.hasDerivAt_sin θ).pow 4
        refine h.congr_deriv ?_; ring
      have hq := (hasDerivAt_const θ (16 : ℝ)).fun_div hden (pow_ne_zero 4 hs_ne)
      refine hq.congr_deriv ?_; field_simp [hs_ne]; ring
    intro θ hθ
    have hs_pos : 0 < Real.sin θ := Real.sin_pos_of_pos_of_lt_pi hθ.1 hθ.2
    have hs_ne : Real.sin θ ≠ 0 := ne_of_gt hs_pos
    have hF2 : HasDerivAt (fun t : ℝ => deriv (fun u : ℝ => topologicalBarrier (hopfAngularCoord u)) t)
        (64 * ((Real.sin θ) ^ 2 + 5 * (Real.cos θ) ^ 2) / (Real.sin θ) ^ 6) θ := by
      have hev : (fun t : ℝ => deriv (fun u : ℝ => topologicalBarrier (hopfAngularCoord u)) t) =ᶠ[𝓝 θ]
          (fun t : ℝ => -64 * Real.cos t / (Real.sin t) ^ 5) := by
        filter_upwards [isOpen_Ioo.mem_nhds hθ] with t ht
        exact (hF1 t ht).deriv
      refine HasDerivAt.congr_of_eventuallyEq ?_ hev
      have hnum : HasDerivAt (fun t : ℝ => -64 * Real.cos t) (64 * Real.sin θ) θ := by
        have h := (Real.hasDerivAt_cos θ).const_mul (-64 : ℝ)
        refine h.congr_deriv ?_; ring
      have hden : HasDerivAt (fun t : ℝ => (Real.sin t) ^ 5) (5 * (Real.sin θ) ^ 4 * Real.cos θ) θ := by
        have h := (Real.hasDerivAt_sin θ).pow 5
        refine h.congr_deriv ?_; ring
      have hq := hnum.fun_div hden (pow_ne_zero 5 hs_ne)
      refine hq.congr_deriv ?_; field_simp [hs_ne]; ring
    rw [hF2.deriv, le_div_iff₀ (pow_pos hs_pos 6)]
    have hs1 : Real.sin θ ≤ 1 := Real.sin_le_one θ
    have hs6 : (Real.sin θ) ^ 6 ≤ 1 := by
      have h := pow_le_pow_left₀ (le_of_lt hs_pos) hs1 6; norm_num at h; exact h
    have hcs := Real.sin_sq_add_cos_sq θ
    nlinarith [sq_nonneg (Real.cos θ)]
  exact ⟨hpart1, hpart2, hpart3, hpart4⟩

