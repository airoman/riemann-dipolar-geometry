private lemma xiResolvent_im_neg_gamma' {σ : ℝ} (hσ : 1 / 2 < σ) (γ : ℝ) :
    (xiResolvent (((-γ : ℝ) : ℂ) + Complex.I * (σ : ℂ))).im =
