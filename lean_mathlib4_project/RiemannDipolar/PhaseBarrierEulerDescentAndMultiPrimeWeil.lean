    · have hlt : σ < 1 / 2 := lt_of_le_of_ne hσ1 htop
      have hre0 : 0 < (((1 / 2 + σ : ℝ) : ℂ) + Complex.I * (γ : ℂ)).re := by simp; linarith
      have hre1 : (((1 / 2 + σ : ℝ) : ℂ) + Complex.I * (γ : ℂ)).re < 1 := by simp; linarith
      have him4 : |(((1 / 2 + σ : ℝ) : ℂ) + Complex.I * (γ : ℂ)).im| ≤ 4 := by simpa using hγ
      intro hz
      exact riemannZeta_ne_zero_explicit_strip_rectangle_four hre0 hre1 him4
        ((riemannXi_eq_zero_iff_riemannZeta hre0 hre1).mp hz)
  refine ⟨fun σ γ hσ0 hσ1 hγ => ?_, fun α σ γ hα hσ hsum hγ => ?_⟩
  · have hxi_ne := hxi_ne_strip σ γ (le_of_lt hσ0) hσ1 hγ
    have hV_pos : 0 < xiNormSq σ γ := by
      dsimp [xiNormSq]
      have harg : (⟨1 / 2 + σ, γ⟩ : ℂ) = ((1 / 2 + σ : ℝ) : ℂ) + Complex.I * (γ : ℂ) := by
