  rw [MeasureTheory.integral_const_mul, integral_exp_mul_Ioi (a := -39) (by norm_num) 1] at hmono
  have hval : 480 * Real.exp 24 * (-Real.exp (-39 * 1) / -39) = (160 / 13 : ℝ) * (Real.exp 15)⁻¹ := by
