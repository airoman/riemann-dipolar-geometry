            (64 / 100 : ℝ) * (10000 : ℝ) ^ (k + 1) := by
          have hpow : (1 / 10 : ℝ) ^ (k + 1) * (100000 : ℝ) ^ (k + 1) = (10000 : ℝ) ^ (k + 1) := by
            rw [← mul_pow]; norm_num
