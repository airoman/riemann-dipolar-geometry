private lemma psiLb3_mono_nonneg' {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) :
    psiLb3 a ≤ psiLb3 b := by
  have hsq : a ^ 2 ≤ b ^ 2 := pow_le_pow_left₀ ha hab 2
  have hrat : ∀ c k : ℝ, 0 < c → 0 ≤ k → k * a ^ 2 / (c + a ^ 2) ≤ k * b ^ 2 / (c + b ^ 2) := by
    intro c k hc hk
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    have hkc : 0 ≤ k * c := mul_nonneg hk (le_of_lt hc)
    nlinarith
  dsimp [psiLb3]
  have h1 := hrat (1 / 4) 4 (by norm_num) (by norm_num)
  have h2 := hrat (25 / 4) (4 / 5) (by norm_num) (by norm_num)
  have h3 := hrat (81 / 4) (4 / 9) (by norm_num) (by norm_num)
  have h4 : Real.log (1 + 4 * a ^ 2 / 169) ≤ Real.log (1 + 4 * b ^ 2 / 169) :=
    Real.log_le_log (by positivity) (by linarith)
  linarith

/-- Helper: Constant-ceiling Archimedean cutoff lower bound on `[-T, T]`. -/
private lemma weilArch_const_envelope_lower {L T C_env : ℝ} (_hL0 : 0 < L) (hT : 0 ≤ T)
    (_hC0 : 0 ≤ C_env) {g : ℝ → ℂ}
    (hbound : ∀ t ∈ Icc (-T) T, ‖compactFourier L g t‖ ^ 2 ≤ C_env * ∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2)
    (hparseval : (1 / (2 * Real.pi)) * (∫ t : ℝ, ‖compactFourier L g t‖ ^ 2) =
      ∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2)
    (hint_arch : Integrable (fun t : ℝ => psiArch t * ‖compactFourier L g t‖ ^ 2))
    (hint_pl : Integrable (fun t : ℝ => ‖compactFourier L g t‖ ^ 2)) :
    (psiLb3 T - (1 / Real.pi) * (T * (psiLb3 T - psiLb3 0) * C_env)) *
        (∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2) ≤
      (1 / (2 * Real.pi)) * (∫ t : ℝ, psiArch t * ‖compactFourier L g t‖ ^ 2) := by
  set N2 : ℝ := ∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2
  have hdiff_int : Integrable (fun t : ℝ => (psiArch t - psiLb3 T) * ‖compactFourier L g t‖ ^ 2) := by
    have h1 := hint_arch.sub (hint_pl.const_mul (psiLb3 T))
    exact h1.congr (Filter.Eventually.of_forall fun t => by simp only [Pi.sub_apply]; ring)
  have hsplit : ∫ t : ℝ, psiArch t * ‖compactFourier L g t‖ ^ 2 =
      psiLb3 T * (∫ t : ℝ, ‖compactFourier L g t‖ ^ 2) +
        ∫ t : ℝ, (psiArch t - psiLb3 T) * ‖compactFourier L g t‖ ^ 2 := by
    rw [← integral_const_mul, ← integral_add (hint_pl.const_mul (psiLb3 T)) hdiff_int]
    congr 1; ext t; ring
  have hlow_pt : ∀ t : ℝ,
      (Icc (-T) T).indicator (fun _ : ℝ => -((psiLb3 T - psiLb3 0) * (C_env * N2))) t ≤
        (psiArch t - psiLb3 T) * ‖compactFourier L g t‖ ^ 2 := by
    intro t
    by_cases ht : t ∈ Icc (-T) T
    · rw [indicator_of_mem ht]
      have habs : |t| ≤ T := abs_le.mpr ht
      have hlb_eq : psiLb3 |t| = psiLb3 t := by dsimp [psiLb3]; rw [sq_abs]
      have hgap_nn : 0 ≤ psiLb3 T - psiLb3 t := by
        rw [← hlb_eq]; exact sub_nonneg.mpr (psiLb3_mono_nonneg' (abs_nonneg t) habs)
      have hgap_le : psiLb3 T - psiLb3 t ≤ psiLb3 T - psiLb3 0 := by
        rw [← hlb_eq]; linarith [psiLb3_mono_nonneg' (le_refl 0) (abs_nonneg t)]
      have hle_arch : -(psiLb3 T - psiLb3 t) ≤ psiArch t - psiLb3 T := by
        linarith [psiArch_ge_psiLb3 t]
      have hfour := hbound t ht
      have hCN_nn : 0 ≤ C_env * N2 := le_trans (sq_nonneg _) hfour
      have hm0 : -((psiLb3 T - psiLb3 0) * (C_env * N2)) ≤ -(psiLb3 T - psiLb3 t) * (C_env * N2) := by
        nlinarith [hCN_nn]
      have hm1 : -(psiLb3 T - psiLb3 t) * (C_env * N2) ≤ -(psiLb3 T - psiLb3 t) * ‖compactFourier L g t‖ ^ 2 := by
        nlinarith
      have hm2 : -(psiLb3 T - psiLb3 t) * ‖compactFourier L g t‖ ^ 2 ≤
          (psiArch t - psiLb3 T) * ‖compactFourier L g t‖ ^ 2 :=
        mul_le_mul_of_nonneg_right hle_arch (sq_nonneg _)
      linarith
    · rw [indicator_of_notMem ht]
      have habs : T ≤ |t| := by
        simp only [mem_Icc, not_and_or, not_le] at ht
        rcases ht with h | h
        · rw [abs_of_neg (by linarith)]; linarith
        · rw [abs_of_pos (by linarith)]; linarith
      have h1 : psiLb3 T ≤ psiArch T := psiArch_ge_psiLb3 T
      have h2 : psiArch T ≤ psiArch |t| := by
        rcases eq_or_lt_of_le habs with heq | hlt
        · rw [← heq]
        · exact le_of_lt (psiArch_strictMono_nonneg hT (abs_nonneg t) hlt)
      have h3 : psiArch |t| = psiArch t := by
        rcases le_total 0 t with h | h
        · rw [abs_of_nonneg h]
        · rw [abs_of_nonpos h, psiArch_even]
      exact mul_nonneg (by linarith) (sq_nonneg _)
  have hint_ind : Integrable ((Icc (-T) T).indicator
      (fun _ : ℝ => -((psiLb3 T - psiLb3 0) * (C_env * N2)))) :=
    (continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc
  have hmono_int := integral_mono hint_ind hdiff_int hlow_pt
  rw [integral_indicator measurableSet_Icc, MeasureTheory.integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le (by linarith : -T ≤ T),
      intervalIntegral.integral_const, smul_eq_mul] at hmono_int
  have hmul_pi := mul_le_mul_of_nonneg_left hmono_int (by positivity : 0 ≤ 1 / (2 * Real.pi))
  have htot : (1 / (2 * Real.pi)) * (∫ t : ℝ, psiArch t * ‖compactFourier L g t‖ ^ 2) =
      psiLb3 T * N2 + (1 / (2 * Real.pi)) * ∫ t : ℝ, (psiArch t - psiLb3 T) * ‖compactFourier L g t‖ ^ 2 := by
    rw [hsplit, mul_add, ← hparseval]; ring
  have hsimp : (1 / (2 * Real.pi)) * ((T - -T) * -((psiLb3 T - psiLb3 0) * (C_env * N2))) =
      -((1 / Real.pi) * (T * (psiLb3 T - psiLb3 0) * C_env)) * N2 := by
    field_simp [ne_of_gt Real.pi_pos]; ring
  rw [hsimp] at hmul_pi
  linarith

/-- THEOREM I.1 (UNIVERSAL PARAMETRIC STIRLING-EXP NO-PARITY CONTINUOUS WEIL ENGINE):
    Combining `compactFourier_all_moments_norm_sq_le` (NO parity restriction!) with the
    Stirling-exp factorial bound `pow_div_272_le_factorial`, for ANY `(L_max, T, m, B_prime, B_pole, c)`
    obeying `68 * L_max * T ≤ 90 * m` and `(1 / Real.pi) * T * G * ((9/4) * L_max * (9/10)^(4m)) + B_prime + B_pole + c ≤ psiLb3 T`:
      `c * ∫_{-L/2}^{L/2} ‖g(u)‖^2 du ≤ weilTotal L g`
    for EVERY `0 < L ≤ L_max` and EVERY continuous `g` orthogonal to `{1, u, ..., u^(2m - 1)}`! -/
theorem weilTotal_continuous_pos_noParity_of_ratio_le_nine_tenths
    {L L_max T G B_prime B_pole c : ℝ} {m : ℕ}
    (hL0 : 0 < L) (hL : L ≤ L_max) (hT : 0 < T) (hm : 1 ≤ m)
    (hratio : 68 * L_max * T ≤ 90 * (m : ℝ))
    (hgap : psiLb3 T - psiLb3 0 ≤ G)
    (hmargin : c + B_prime + B_pole +
      (1 / Real.pi) * (T * G * ((9 / 4 : ℝ) * L_max * (9 / 10 : ℝ) ^ (4 * m))) ≤ psiLb3 T)
    {g : ℝ → ℂ} (hg : Continuous g)
    (hmom : ∀ k : ℕ, k < 2 * m → ∫ u in (-L / 2)..(L / 2), ((u ^ k : ℝ) : ℂ) * g u = 0)
    (hprime : weilPrime L g ≤ B_prime * ∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2)
    (hpole : -B_pole * (∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2) ≤ weilPole L g)
    (hparseval : (1 / (2 * Real.pi)) * (∫ t : ℝ, ‖compactFourier L g t‖ ^ 2) =
      ∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2)
    (hint_arch : Integrable (fun t : ℝ => psiArch t * ‖compactFourier L g t‖ ^ 2))
    (hint_pl : Integrable (fun t : ℝ => ‖compactFourier L g t‖ ^ 2)) :
    c * (∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2) ≤ weilTotal L g := by
  set N2 : ℝ := ∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2
  have hN2_nn : 0 ≤ N2 := intervalIntegral.integral_nonneg (by linarith) fun _ _ => sq_nonneg _
  have hLmax_pos : 0 < L_max := lt_of_lt_of_le hL0 hL
  have hm_pos : (0 : ℝ) < (m : ℝ) := by exact_mod_cast (by omega : 0 < m)
  set C_env : ℝ := (9 / 4 : ℝ) * L_max * (9 / 10 : ℝ) ^ (4 * m)
  have hC0 : 0 ≤ C_env := by dsimp [C_env]; positivity
  -- Show `‖compactFourier L g t‖^2 ≤ C_env * N2` on `[-T, T]` via Stirling-exp!
  have hbound : ∀ t ∈ Icc (-T) T, ‖compactFourier L g t‖ ^ 2 ≤ C_env * N2 := by
    intro t ht
    have h1 := compactFourier_all_moments_norm_sq_le (le_of_lt hL0) m hg hmom t
    refine le_trans h1 (mul_le_mul_of_nonneg_right ?_ hN2_nn)
    set x : ℝ := |t| * (L / 2)
    have hx_nn : 0 ≤ x := by dsimp [x]; positivity
    have hx_le : x ≤ T * L_max / 2 := by
      have habs : |t| ≤ T := abs_le.mpr ht
      have hprod : |t| * L ≤ T * L_max := mul_le_mul habs hL (le_of_lt hL0) (le_of_lt hT)
      dsimp [x]; linarith
    -- Factor `(2m+1)! = (2m+1) * (2m)!`, and `x / (2m+1) ≤ 1/2`!
    have hfac_succ : ((2 * m + 1).factorial : ℝ) = ((2 * m + 1 : ℕ) : ℝ) * ((2 * m).factorial : ℝ) := by
      exact_mod_cast Nat.factorial_succ (2 * m)
    have hx_div : x / ((2 * m + 1 : ℕ) : ℝ) ≤ 1 / 2 := by
      rw [div_le_iff₀ (by positivity)]
      have hcast : ((2 * m + 1 : ℕ) : ℝ) = 2 * (m : ℝ) + 1 := by push_cast; ring
      rw [hcast]
      -- `T * L_max / 2 ≤ (90/136) * m < m < m + 1/2`!
      nlinarith
    have hterm_odd : x ^ (2 * m + 1) / ((2 * m + 1).factorial : ℝ) ≤
        (1 / 2 : ℝ) * (x ^ (2 * m) / ((2 * m).factorial : ℝ)) := by
      rw [pow_succ, hfac_succ]
      have hrew : x ^ (2 * m) * x / (((2 * m + 1 : ℕ) : ℝ) * ((2 * m).factorial : ℝ)) =
          (x / ((2 * m + 1 : ℕ) : ℝ)) * (x ^ (2 * m) / ((2 * m).factorial : ℝ)) := by ring
      rw [hrew]
      exact mul_le_mul_of_nonneg_right hx_div (by positivity)
    -- Stirling-exp bound on `x^(2m) / (2m)! ≤ (9/10)^(2m)`!
    have hterm_even : x ^ (2 * m) / ((2 * m).factorial : ℝ) ≤ (9 / 10 : ℝ) ^ (2 * m) := by
      have hst := pow_div_272_le_factorial (2 * m)
      have hst_pos : (0 : ℝ) < (100 * ((2 * m : ℕ) : ℝ) / 272) ^ (2 * m) := by positivity
      have hdiv_le : x ^ (2 * m) / ((2 * m).factorial : ℝ) ≤
          x ^ (2 * m) / (100 * ((2 * m : ℕ) : ℝ) / 272) ^ (2 * m) :=
        div_le_div_of_nonneg_left (pow_nonneg hx_nn _) hst_pos hst
      rw [← div_pow] at hdiv_le
      have hbase : x / (100 * ((2 * m : ℕ) : ℝ) / 272) ≤ 9 / 10 := by
        rw [div_le_iff₀ (by positivity)]
        have hcast : ((2 * m : ℕ) : ℝ) = 2 * (m : ℝ) := by push_cast; ring
        rw [hcast]; linarith
      exact le_trans hdiv_le (pow_le_pow_left₀ (by positivity) hbase (2 * m))
    have hsum_le : x ^ (2 * m) / ((2 * m).factorial : ℝ) + x ^ (2 * m + 1) / ((2 * m + 1).factorial : ℝ) ≤
        (3 / 2 : ℝ) * (9 / 10 : ℝ) ^ (2 * m) := by linarith
    have hsq_le : (x ^ (2 * m) / ((2 * m).factorial : ℝ) + x ^ (2 * m + 1) / ((2 * m + 1).factorial : ℝ)) ^ 2 ≤
        (9 / 4 : ℝ) * (9 / 10 : ℝ) ^ (4 * m) := by
      have h1 := pow_le_pow_left₀ (by positivity) hsum_le 2
      have heq : ((3 / 2 : ℝ) * (9 / 10 : ℝ) ^ (2 * m)) ^ 2 = (9 / 4 : ℝ) * (9 / 10 : ℝ) ^ (4 * m) := by
        rw [mul_pow, ← pow_mul, show 2 * m * 2 = 4 * m by omega]; norm_num
      rwa [heq] at h1
    dsimp [C_env]
    calc L * (x ^ (2 * m) / ((2 * m).factorial : ℝ) + x ^ (2 * m + 1) / ((2 * m + 1).factorial : ℝ)) ^ 2
      _ ≤ L_max * ((9 / 4 : ℝ) * (9 / 10 : ℝ) ^ (4 * m)) :=
          mul_le_mul hL hsq_le (by positivity) (le_of_lt hLmax_pos)
      _ = (9 / 4 : ℝ) * L_max * (9 / 10 : ℝ) ^ (4 * m) := by ring
  have harch := weilArch_const_envelope_lower hL0 (le_of_lt hT) hC0 hbound hparseval hint_arch hint_pl
  have hgap_nn : 0 ≤ psiLb3 T - psiLb3 0 :=
    sub_nonneg.mpr (psiLb3_mono_nonneg' (le_refl 0) (le_of_lt hT))
  have hpen_le : (1 / Real.pi) * (T * (psiLb3 T - psiLb3 0) * C_env) ≤
      (1 / Real.pi) * (T * G * C_env) := by
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hgap (le_of_lt hT)) hC0
  have hcoeff : c ≤ (psiLb3 T - (1 / Real.pi) * (T * (psiLb3 T - psiLb3 0) * C_env)) -
      B_prime - B_pole := by
    have hpen_le' : (1 / Real.pi) * (T * (psiLb3 T - psiLb3 0) * C_env) ≤
        (1 / Real.pi) * (T * G * ((9 / 4 : ℝ) * L_max * (9 / 10 : ℝ) ^ (4 * m))) := hpen_le
    linarith
  have hmul := mul_le_mul_of_nonneg_right hcoeff hN2_nn
  unfold weilTotal
  dsimp [N2] at hmul
  linarith [harch, hprime, hpole, hmul]

/-- Helper: Unified subset prime-shift norm bound using the Disjoint-Strip 1/2-factor whenever
    `L_max / 2 ≤ Real.log n`, with ZERO case splitting on `Nat.floor (Real.exp L)`! -/
private lemma weilPrime_disjoint_subset_bound {L L_max : ℝ} {N_max : ℕ}
    (hL0 : 0 < L) (hL : L ≤ L_max) (hfl : Nat.floor (Real.exp L) ≤ N_max)
    {g : ℝ → ℂ} (hg : Continuous g) :
    |weilPrime L g| ≤
      (∑ n ∈ Finset.Icc 2 N_max,
        (if L_max / 2 ≤ Real.log (n : ℝ) then (1 : ℝ) else 2) *
          (ArithmeticFunction.vonMangoldt n / Real.sqrt (n : ℝ))) *
      ∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2 := by
  have hN2_nn : 0 ≤ ∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2 :=
    intervalIntegral.integral_nonneg (by linarith) fun _ _ => sq_nonneg _
  dsimp [weilPrime]
  rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
  have htri : |∑ n ∈ Finset.Icc 2 (Nat.floor (Real.exp L)),
      (ArithmeticFunction.vonMangoldt n / Real.sqrt (n : ℝ)) *
        (∫ u in (-L / 2 + Real.log (n : ℝ))..(L / 2),
          g u * starRingEnd ℂ (g (u - Real.log (n : ℝ)))).re| ≤
      ∑ n ∈ Finset.Icc 2 (Nat.floor (Real.exp L)),
        (1 / 2 : ℝ) * ((if L_max / 2 ≤ Real.log (n : ℝ) then (1 : ℝ) else 2) *
          (ArithmeticFunction.vonMangoldt n / Real.sqrt (n : ℝ))) *
        ∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2 := by
    refine le_trans (Finset.abs_sum_le_sum_abs _ _) (Finset.sum_le_sum fun n hn => ?_)
    rw [Finset.mem_Icc] at hn
    have hn_ge2 : (2 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn.1
    have hn_le_exp : (n : ℝ) ≤ Real.exp L :=
      (Nat.le_floor_iff (le_of_lt (Real.exp_pos L))).mp hn.2
    have hlog_nn : 0 ≤ Real.log (n : ℝ) := Real.log_nonneg (by linarith)
    have hlog_le : Real.log (n : ℝ) ≤ L := by
      have := Real.log_le_log (by linarith : (0 : ℝ) < n) hn_le_exp
      rwa [Real.log_exp] at this
    have hcoeff_nn : 0 ≤ ArithmeticFunction.vonMangoldt n / Real.sqrt (n : ℝ) :=
      div_nonneg ArithmeticFunction.vonMangoldt_nonneg (Real.sqrt_nonneg _)
    rw [abs_mul, abs_of_nonneg hcoeff_nn]
    by_cases hdisj : L_max / 2 ≤ Real.log (n : ℝ)
    · simp only [hdisj, ↓reduceIte, one_mul]
      have hov := shift_overlap_re_le_half_L2_of_disjoint (by linarith : L / 2 ≤ Real.log (n : ℝ)) hlog_le hg
      have hmul := mul_le_mul_of_nonneg_left hov hcoeff_nn
      linarith
    · simp only [hdisj, ↓reduceIte]
      have hov := shift_overlap_re_le_L2 hlog_nn hlog_le hg
      have hmul := mul_le_mul_of_nonneg_left hov hcoeff_nn
      linarith
  have hsub : Finset.Icc 2 (Nat.floor (Real.exp L)) ⊆ Finset.Icc 2 N_max :=
    Finset.Icc_subset_Icc_right hfl
  have hsum_sub : ∑ n ∈ Finset.Icc 2 (Nat.floor (Real.exp L)),
        (1 / 2 : ℝ) * ((if L_max / 2 ≤ Real.log (n : ℝ) then (1 : ℝ) else 2) *
          (ArithmeticFunction.vonMangoldt n / Real.sqrt (n : ℝ))) *
        ∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2 ≤
      ∑ n ∈ Finset.Icc 2 N_max,
        (1 / 2 : ℝ) * ((if L_max / 2 ≤ Real.log (n : ℝ) then (1 : ℝ) else 2) *
          (ArithmeticFunction.vonMangoldt n / Real.sqrt (n : ℝ))) *
        ∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2 :=
    Finset.sum_le_sum_of_subset_of_nonneg hsub fun n _ _ => by
      have h1 : (0 : ℝ) ≤ (if L_max / 2 ≤ Real.log (n : ℝ) then (1 : ℝ) else 2) := by
        split_ifs <;> norm_num
      have h2 : 0 ≤ ArithmeticFunction.vonMangoldt n / Real.sqrt (n : ℝ) :=
        div_nonneg ArithmeticFunction.vonMangoldt_nonneg (Real.sqrt_nonneg _)
      positivity
  have htot := le_trans htri hsum_sub
  rw [← Finset.sum_mul, ← Finset.mul_sum] at htot
  have h2 := mul_le_mul_of_nonneg_left htot (by norm_num : (0 : ℝ) ≤ 2)
  linarith

private lemma vonMangoldt_six_eq_zero : ArithmeticFunction.vonMangoldt 6 = 0 := by
  rw [ArithmeticFunction.vonMangoldt_eq_zero_iff]
  rintro ⟨p, k, hp, hk, heq⟩
  have hp_prime : p.Prime := hp.nat_prime
  have h2 : 2 ∣ p ^ k := by rw [heq]; norm_num
  have h3 : 3 ∣ p ^ k := by rw [heq]; norm_num
  have hp2 : p = 2 := ((hp_prime.eq_one_or_self_of_dvd 2 (Nat.prime_two.dvd_of_dvd_pow h2)).resolve_left (by norm_num)).symm
  have hp3 : p = 3 := ((hp_prime.eq_one_or_self_of_dvd 3 (Nat.prime_three.dvd_of_dvd_pow h3)).resolve_left (by norm_num)).symm
  omega

private lemma sinh_sub_le_of_exp_le {x E : ℝ} (_hx0 : 0 ≤ x) (hE : Real.exp x ≤ E) (hE_pos : 0 < E) :
    2 * (Real.sinh x - x) ≤ E - E⁻¹ - 2 * x := by
  rw [Real.sinh_eq, Real.exp_neg]
  have hinv : E⁻¹ ≤ (Real.exp x)⁻¹ := (inv_le_inv₀ hE_pos (Real.exp_pos x)).mpr hE
  linarith

private lemma nine_tenths_pow_100_le : (9 / 10 : ℝ) ^ 100 ≤ 3 / 100000 := by
  have h20 : (9 / 10 : ℝ) ^ 20 ≤ 122 / 1000 := by norm_num
  have h100 : (9 / 10 : ℝ) ^ 100 = ((9 / 10 : ℝ) ^ 20) ^ 5 := by ring
  rw [h100]
  have hp := pow_le_pow_left₀ (by positivity) h20 5
  norm_num at hp ⊢

private lemma nine_tenths_pow_200_le : (9 / 10 : ℝ) ^ 200 ≤ 1 / 1000000000 := by
  have h100 := nine_tenths_pow_100_le
  have h200 : (9 / 10 : ℝ) ^ 200 = ((9 / 10 : ℝ) ^ 100) ^ 2 := by ring
  rw [h200]
  have hp := pow_le_pow_left₀ (by positivity) h100 2
  norm_num at hp ⊢

/-- THEOREM I.2 (NO-PARITY TWO-PRIME CONTINUOUS WEIL POSITIVITY ON `0 < L ≤ 6/5 > ln 3`):
    Completely removes the even-parity hypothesis of Module #18's Theorem I.4 (`{2, 3}` active,
    zero discretization, `m = 28`, `T = 30`, coercive floor `1/10`)! -/
theorem weilTotal_continuous_pos_noParity_primes_two_three_up_to_six_fifths
    {L : ℝ} (hL0 : 0 < L) (hL : L ≤ 6 / 5) {g : ℝ → ℂ} (hg : Continuous g)
    (hmom : ∀ k : ℕ, k < 2 * 28 → ∫ u in (-L / 2)..(L / 2), ((u ^ k : ℝ) : ℂ) * g u = 0)
    (hparseval : (1 / (2 * Real.pi)) * (∫ t : ℝ, ‖compactFourier L g t‖ ^ 2) =
      ∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2)
    (hint_arch : Integrable (fun t : ℝ => psiArch t * ‖compactFourier L g t‖ ^ 2))
    (hint_pl : Integrable (fun t : ℝ => ‖compactFourier L g t‖ ^ 2)) :
    (1 / 10 : ℝ) * (∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2) ≤ weilTotal L g := by
  have hN2_nn : 0 ≤ ∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2 :=
    intervalIntegral.integral_nonneg (by linarith) fun _ _ => sq_nonneg _
  have hexp_lt4 : Real.exp L < ((4 : ℕ) : ℝ) := by
    have h1 : Real.exp L ≤ Real.exp (6 / 5) := Real.exp_le_exp.mpr hL
    have h2 := exp_le_pow4_taylor (y := 6 / 5) (B := 135 / 100) (by norm_num) (by norm_num) (by norm_num)
      (by simp only [Finset.sum_range_succ, Finset.range_zero, Finset.sum_empty, Nat.factorial]; norm_num)
    norm_num at h2 ⊢; linarith
  have hfl : Nat.floor (Real.exp L) ≤ 3 := by
    have hlt4 : Nat.floor (Real.exp L) < 4 := (Nat.floor_lt (le_of_lt (Real.exp_pos L))).mpr hexp_lt4
    omega
  have hprime_raw := (abs_le.mp (weilPrime_disjoint_subset_bound (L_max := 6 / 5) (N_max := 3) hL0 hL hfl hg)).2
  have hBprime : (∑ n ∈ Finset.Icc (2 : ℕ) 3,
      (if (6 / 5 : ℝ) / 2 ≤ Real.log (n : ℝ) then (1 : ℝ) else 2) *
        (ArithmeticFunction.vonMangoldt n / Real.sqrt (n : ℝ))) ≤ 1126 / 1000 := by
    rw [show Finset.Icc (2 : ℕ) 3 = {2, 3} by decide, Finset.sum_pair (by decide)]
    have hvm2 : ArithmeticFunction.vonMangoldt 2 = Real.log 2 := by
      simpa using ArithmeticFunction.vonMangoldt_apply_prime Nat.prime_two
    have hvm3 : ArithmeticFunction.vonMangoldt 3 = Real.log 3 := by
      simpa using ArithmeticFunction.vonMangoldt_apply_prime Nat.prime_three
    rw [hvm2, hvm3]; push_cast
    have hc2 : (6 / 5 : ℝ) / 2 ≤ Real.log 2 := by linarith [log_2_bounds.1]
    have hc3 : (6 / 5 : ℝ) / 2 ≤ Real.log 3 := by linarith [log_3_bounds.1]
    simp only [hc2, hc3, ↓reduceIte, one_mul]
    have hsq2 : (1414 / 1000 : ℝ) ≤ Real.sqrt 2 := by rw [Real.le_sqrt (by norm_num) (by norm_num)]; norm_num
    have hsq3 : (1732 / 1000 : ℝ) ≤ Real.sqrt 3 := by rw [Real.le_sqrt (by norm_num) (by norm_num)]; norm_num
    have h2 : Real.log 2 / Real.sqrt 2 ≤ (6932 / 10000 : ℝ) / (1414 / 1000) :=
      div_le_div₀ (by norm_num) (log_2_bounds.2.trans (by norm_num)) (by norm_num) hsq2
    have h3 : Real.log 3 / Real.sqrt 3 ≤ (10987 / 10000 : ℝ) / (1732 / 1000) :=
      div_le_div₀ (by norm_num) (log_3_bounds.2.trans (by norm_num)) (by norm_num) hsq3
    norm_num at h2 h3 ⊢; linarith
  have hprime : weilPrime L g ≤ (1126 / 1000 : ℝ) * ∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2 :=
    le_trans hprime_raw (mul_le_mul_of_nonneg_right hBprime hN2_nn)
  have hpole : -(75 / 1000 : ℝ) * (∫ u in (-L / 2)..(L / 2), ‖g u‖ ^ 2) ≤ weilPole L g := by
    have hp0 := weilPole_lower_bound_all (le_of_lt hL0) hg
    have hmono : Real.sinh (L / 2) - L / 2 ≤ Real.sinh (3 / 5) - 3 / 5 := by
      have hd : ∀ x : ℝ, HasDerivAt (fun t => Real.sinh t - t) (Real.cosh x - 1) x := fun x =>
        (Real.hasDerivAt_sinh x).sub (hasDerivAt_id' x)
      have hM : MonotoneOn (fun t : ℝ => Real.sinh t - t) (Icc 0 (3 / 5)) :=
        monotoneOn_of_deriv_nonneg (convex_Icc 0 (3 / 5))
          (fun x _ => (hd x).continuousAt.continuousWithinAt)
          (fun x _ => (hd x).differentiableAt.differentiableWithinAt)
          (fun x _ => by rw [(hd x).deriv]; linarith [Real.one_le_cosh x])
      exact hM ⟨by linarith, by linarith⟩ ⟨by norm_num, le_refl _⟩ (by linarith)
    have hexp : Real.exp (3 / 5 : ℝ) ≤ 1823 / 1000 := by
      have h := exp_le_taylor_small (y := 3 / 5) (by norm_num) (by norm_num) (n := 7) (by norm_num)
      simp only [Finset.sum_range_succ, Finset.range_zero, Finset.sum_empty, Nat.factorial] at h
      norm_num at h; linarith
    have hsb := sinh_sub_le_of_exp_le (by norm_num) hexp (by norm_num)
    have hbp : 2 * (Real.sinh (L / 2) - L / 2) ≤ 75 / 1000 := by norm_num at hsb; linarith
    have hmul := mul_le_mul_of_nonneg_right hbp hN2_nn
    linarith
  have hlog30_ge : (310 / 100 : ℝ) ≤ Real.log (1 + 4 * (30 : ℝ) ^ 2 / 169) :=
    log_ge_of_pow4 (by norm_num) (by norm_num) (by positivity)
      (by simp only [Finset.sum_range_succ, Finset.range_zero, Finset.sum_empty, Nat.factorial]; norm_num)
  have hlog30_le : Real.log (1 + 4 * (30 : ℝ) ^ 2 / 169) ≤ 315 / 100 :=
    log_le_of_pow4 (by norm_num) (by positivity)
