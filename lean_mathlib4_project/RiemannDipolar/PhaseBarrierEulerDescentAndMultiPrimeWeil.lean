        nlinarith
      have h2 : (289 : ℝ) / ((x + (k : ℝ)) * ((x + (k : ℝ)) ^ 2 + 289)) ≤
          (-γ / 2) ^ 2 / ((x + (k : ℝ)) * ((x + (k : ℝ)) ^ 2 + (-γ / 2) ^ 2)) := by
        rw [div_le_div_iff₀ (by positivity) (by positivity)]
