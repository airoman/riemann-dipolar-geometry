/-- THEOREM 0.1 (TIGHT CERTIFIED EULER-MASCHERONI BOUND `γ_E < 5783 / 10000`):
    Tightening Module #18's `5813 / 10000` by 30 bps via `harmonic 512 - 9 log 2`. -/
theorem eulerMascheroniConstant_lt_5783_div_10000 :
    Real.eulerMascheroniConstant < 5783 / 10000 := by
  have hlt : Real.eulerMascheroniConstant < Real.eulerMascheroniSeq' 512 :=
    Real.eulerMascheroniConstant_lt_eulerMascheroniSeq' 512
  have hseq : Real.eulerMascheroniSeq' 512 = ((harmonic 512 : ℚ) : ℝ) - Real.log ((512 : ℕ) : ℝ) := by
    dsimp [Real.eulerMascheroniSeq']
  rw [hseq] at hlt
  have hlog512 : Real.log ((512 : ℕ) : ℝ) = 9 * Real.log 2 := by
    rw [show ((512 : ℕ) : ℝ) = (2 : ℝ) ^ (9 : ℕ) by norm_num, Real.log_pow]; norm_num
  rw [hlog512] at hlt
  linarith [harmonic_512_le, log_two_ge_693147]

