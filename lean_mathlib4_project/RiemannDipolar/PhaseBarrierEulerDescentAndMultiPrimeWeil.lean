  have hinv : (Real.exp 15)⁻¹ ≤ (3000000 : ℝ)⁻¹ := (inv_le_inv₀ (Real.exp_pos _) (by norm_num)).mpr he15
  have hfin : (160 / 13 : ℝ) * (Real.exp 15)⁻¹ ≤ 1 / 100000 := by
    have h1 := mul_le_mul_of_nonneg_left hinv (by norm_num : (0 : ℝ) ≤ 160 / 13)
    norm_num at h1 ⊢; linarith
  linarith

