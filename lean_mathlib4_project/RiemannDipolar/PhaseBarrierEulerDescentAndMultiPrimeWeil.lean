private lemma riemannPhi_le_of_brackets' {a e2_lo e2_hi eh_hi e_pi_lo c_hi : ℝ}
    (ha : 0 ≤ a) (he2_lo : e2_lo ≤ Real.exp (2 * a)) (he2_hi : Real.exp (2 * a) ≤ e2_hi)
    (he2_ge1 : 1 ≤ e2_lo)
