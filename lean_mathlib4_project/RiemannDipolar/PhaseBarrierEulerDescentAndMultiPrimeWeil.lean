        · have h1 : (1 : ℝ) ≤ ((n + 150 : ℕ) : ℝ) := by exact_mod_cast (by omega : 1 ≤ n + 150)
          exact div_nonneg (Real.log_nonneg h1) (sq_nonneg _)
        · exact le_refl 0
      dsimp [tailTerm]
