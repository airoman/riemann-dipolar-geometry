    have hlog4 : (13862 / 10000 : ℝ) ≤ Real.log (1 + (-γ / 2) ^ 2 / (x + ((8 : ℕ) : ℝ)) ^ 2) := by
      have h4_le : (13862 / 10000 : ℝ) ≤ Real.log 4 := by
        rw [show (4 : ℝ) = 2 ^ (2 : ℕ) by norm_num, Real.log_pow]; norm_num; linarith [log_2_bounds.1]
