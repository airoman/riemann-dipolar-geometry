               Complex.sub_re, Complex.add_re, Complex.mul_re]
    norm_num [hlogpi]
  have hp1 : 0 ≤ (1 / s).re := by
    rw [hs_eq, one_div, Complex.inv_re]; exact div_nonneg (by linarith) (Complex.normSq_nonneg _)
  have hp2 : 0 ≤ (1 / (s - 1)).re := by
    have hs1 : s - 1 = (⟨β - 1, -γ⟩ : ℂ) := by rw [hs_eq]; apply Complex.ext <;> simp
    rw [hs1, one_div, Complex.inv_re]; exact div_nonneg (by linarith) (Complex.normSq_nonneg _)
  set x : ℝ := β / 2
  have hx0 : 1 ≤ x := by dsimp [x]; linarith
  have hx1 : x ≤ 5 / 4 := by dsimp [x]; linarith
  have hψ_real : (-5783 / 10000 : ℝ) ≤ (Complex.digamma ((x : ℝ) : ℂ)).re := by
    have hmono := complex_digamma_real_diff_ge_finset (a := 1) (b := x) (by norm_num) hx0 0
    simp only [Finset.range_zero, Finset.sum_empty, add_zero] at hmono
    have hdig1 : (-5783 / 10000 : ℝ) ≤ (Complex.digamma ((1 : ℝ) : ℂ)).re := by simpa using digamma_one_ge
    exact le_trans hdig1 hmono
  have hdig : (-5783 / 10000 : ℝ) +
      (∑ k ∈ Finset.range 8, (289 : ℝ) / (((5 / 4 + (k : ℝ))) * ((5 / 4 + (k : ℝ)) ^ 2 + 289))) +
      (1 / 2 : ℝ) * (13862 / 10000) ≤ (Complex.digamma (s / 2)).re := by
    have hs2 : s / 2 = (⟨x, -γ / 2⟩ : ℂ) := by rw [hs_eq]; dsimp [x]; apply Complex.ext <;> simp
    rw [hs2]
    have hd0 := complex_digamma_re_ge_real_add_finset_add_log_tail (x := x) (by linarith) (-γ / 2) 8
    have hy2_ge : (289 : ℝ) ≤ (-γ / 2) ^ 2 := by
      have h17 : (17 : ℝ) ≤ |γ| / 2 := by linarith
      have hsq : (17 : ℝ) ^ 2 ≤ (|γ| / 2) ^ 2 := pow_le_pow_left₀ (by norm_num) h17 2
      have heq : (|γ| / 2) ^ 2 = (-γ / 2) ^ 2 := by rw [div_pow, sq_abs]; ring
      linarith
    have hsum_le : ∑ k ∈ Finset.range 8, (289 : ℝ) / (((5 / 4 + (k : ℝ))) * ((5 / 4 + (k : ℝ)) ^ 2 + 289)) ≤
        ∑ k ∈ Finset.range 8, (-γ / 2) ^ 2 / (((x + (k : ℝ))) * ((x + (k : ℝ)) ^ 2 + (-γ / 2) ^ 2)) := by
      refine Finset.sum_le_sum fun k _ => ?_
      have ha_pos : 0 < x + (k : ℝ) := by positivity
      have hb_pos : 0 < 5 / 4 + (k : ℝ) := by positivity
      have hab : x + (k : ℝ) ≤ 5 / 4 + (k : ℝ) := by linarith
      have h1 : (289 : ℝ) / ((5 / 4 + (k : ℝ)) * ((5 / 4 + (k : ℝ)) ^ 2 + 289)) ≤
          (289 : ℝ) / ((x + (k : ℝ)) * ((x + (k : ℝ)) ^ 2 + 289)) := by
        refine div_le_div_of_nonneg_left (by norm_num) (by positivity) ?_
