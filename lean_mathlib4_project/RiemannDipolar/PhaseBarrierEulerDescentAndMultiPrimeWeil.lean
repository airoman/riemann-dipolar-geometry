/-- Large-`γ` boundary on `σ = 3/2` (`β = 2`): for ALL `γ ≥ 21`! -/
private lemma xiResolvent_im_pos_beta2_large_gamma {γ : ℝ} (hγ : 21 ≤ γ) :
    0 < (xiResolvent ((γ : ℂ) + Complex.I * ((3 / 2 : ℝ) : ℂ))).im := by
  set z : ℂ := (γ : ℂ) + Complex.I * ((3 / 2 : ℝ) : ℂ)
  have hz_im : 1 / 2 < z.im := by dsimp [z]; simp; norm_num
  have hexp := xiResolvent_eq_explicit_vonMangoldt_of_half_lt_im hz_im
  dsimp only at hexp
  set s : ℂ := 1 / 2 - Complex.I * z
  have hs_eq : s = (⟨2, -γ⟩ : ℂ) := by
    dsimp [s, z]; exact Complex.ext (by simp; norm_num) (by simp)
  have him_eq : (xiResolvent z).im =
      (1 / s).re + (1 / (s - 1)).re - (1 / 2 : ℝ) * Real.log Real.pi +
        (1 / 2 : ℝ) * (Complex.digamma (s / 2)).re -
        (LSeries (fun n => (ArithmeticFunction.vonMangoldt n : ℂ)) s).re := by
    rw [hexp]
    have hlogpi : (Complex.log (Real.pi : ℂ)).re = Real.log Real.pi := by
      rw [← Complex.ofReal_log (le_of_lt Real.pi_pos), Complex.ofReal_re]
    simp only [Complex.mul_im, Complex.I_re, Complex.I_im, zero_mul, one_mul, zero_add,
               Complex.sub_re, Complex.add_re, Complex.mul_re]
    norm_num [hlogpi]
  have hp1 : 0 ≤ (1 / s).re := by
    rw [hs_eq, one_div, Complex.inv_re]; exact div_nonneg (by norm_num) (Complex.normSq_nonneg _)
  have hp2 : 0 ≤ (1 / (s - 1)).re := by
    have hs1 : s - 1 = (⟨1, -γ⟩ : ℂ) := by rw [hs_eq]; exact Complex.ext (by simp; norm_num) (by simp)
    rw [hs1, one_div, Complex.inv_re]; exact div_nonneg (by norm_num) (Complex.normSq_nonneg _)
  have hdig : (-5783 / 10000 : ℝ) +
      (∑ k ∈ Finset.range 8, (21 / 2 : ℝ) ^ 2 / (((1 + (k : ℝ))) * ((1 + (k : ℝ)) ^ 2 + (21 / 2 : ℝ) ^ 2))) +
      (1 / 2 : ℝ) * (859 / 1000) ≤ (Complex.digamma (s / 2)).re := by
    have hs2 : s / 2 = (⟨1, -γ / 2⟩ : ℂ) := by
      rw [hs_eq]; exact Complex.ext (by simp) (by simp)
    rw [hs2]
    have hd0 := complex_digamma_re_ge_real_add_finset_add_log_tail (x := 1) (by norm_num) (-γ / 2) 8
    have hy2_ge : (21 / 2 : ℝ) ^ 2 ≤ (-γ / 2) ^ 2 := by
      have h1 : (21 / 2 : ℝ) ^ 2 ≤ (γ / 2) ^ 2 := pow_le_pow_left₀ (by norm_num) (by linarith) 2
      have h2 : (-γ / 2) ^ 2 = (γ / 2) ^ 2 := by ring
      linarith
    have hsum_le : ∑ k ∈ Finset.range 8, (21 / 2 : ℝ) ^ 2 / (((1 + (k : ℝ))) * ((1 + (k : ℝ)) ^ 2 + (21 / 2 : ℝ) ^ 2)) ≤
        ∑ k ∈ Finset.range 8, (-γ / 2) ^ 2 / (((1 + (k : ℝ))) * ((1 + (k : ℝ)) ^ 2 + (-γ / 2) ^ 2)) := by
      refine Finset.sum_le_sum fun k _ => ?_
      have ha : (0 : ℝ) < 1 + (k : ℝ) := by positivity
      rw [div_le_div_iff₀ (by positivity) (by positivity)]
      nlinarith [mul_pos ha (sq_pos_of_pos ha)]
    have hlog859 : (859 / 1000 : ℝ) ≤ Real.log (1 + (-γ / 2) ^ 2 / (1 + ((8 : ℕ) : ℝ)) ^ 2) := by
      have h1 : (859 / 1000 : ℝ) ≤ Real.log (1 + (21 / 2 : ℝ) ^ 2 / (9 : ℝ) ^ 2) :=
        log_lb_of_tay6' (by norm_num) (by norm_num)
          (by simp only [Finset.sum_range_succ, Finset.range_zero, Finset.sum_empty, Nat.factorial]; norm_num)
      refine le_trans h1 (Real.log_le_log (by positivity) ?_)
      have h9 : (1 + ((8 : ℕ) : ℝ)) ^ 2 = (9 : ℝ) ^ 2 := by norm_num
      rw [h9]
      have := div_le_div_of_nonneg_right hy2_ge (by positivity : (0 : ℝ) ≤ (9 : ℝ) ^ 2)
      linarith
    have hdig1 : (-5783 / 10000 : ℝ) ≤ (Complex.digamma ((1 : ℝ) : ℂ)).re := by simpa using digamma_one_ge
    linarith
  have hL_ub : (LSeries (fun n => (ArithmeticFunction.vonMangoldt n : ℂ)) s).re ≤ 1151 / 2000 := by
    rw [hs_eq]; exact cliffordTorus_primePhase_euler_split_15primes.2 (le_refl 2) γ
  rw [him_eq]
  have hnum : (0 : ℝ) < -(1 / 2 : ℝ) * (11448 / 10000) +
      (1 / 2 : ℝ) * ((-5783 / 10000 : ℝ) +
        (∑ k ∈ Finset.range 8, (21 / 2 : ℝ) ^ 2 / (((1 + (k : ℝ))) * ((1 + (k : ℝ)) ^ 2 + (21 / 2 : ℝ) ^ 2))) +
        (1 / 2 : ℝ) * (859 / 1000)) - (1151 / 2000 : ℝ) := by
    simp only [Finset.sum_range_succ, Finset.range_zero, Finset.sum_empty]; norm_num
  linarith [log_pi_le_11448]

